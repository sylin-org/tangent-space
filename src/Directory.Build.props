<Project>
  <PropertyGroup>
    <KoanSourceRoot Condition="'$(KoanSourceRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../.local/upstream/koan-framework'))</KoanSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(KoanSourceRoot)/src/Koan.Core.Registry.Generators/Koan.Core.Registry.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
