@using System.Globalization
@using Tangent.Tangents
@* One Topic in a Tangent's list. In a discussions Tangent it is a row of the table: a dot when it is new to the
   reader, its title with any pin or lock, who started it and its opening words, its latest reply on the page's colour
   with "New" when the reader has not seen it, the faces of its recent authors, its replies with how many Posts are
   new, and when it last gained a Post and from whom. In an articles Tangent it is an article: the lead, first on the
   first page, with its cover, date and read time, opening, author and latest-reply strip; the rest as rows. An
   article without a cover image leads with the Tangent's own: its tile and name on the image band over its edge,
   never the title again. Zeros are said in words, and how many replies are new is said the same way beside every
   count. *@
@if (Article)
{
    <article class="@ArticleClass()">
        @if (Lead)
        {
            <a class="article-cover tone-@TangentTile.Tone" href="@Model.Address" tabindex="-1" aria-hidden="true">
                <TangentTile Tile="@TangentTile" Size="cover" />
                <span class="article-cover-tangent">@TangentName</span>
                <span class="article-cover-edge"></span>
            </a>
        }
        <div class="article-card-text">
            <p class="article-card-date">
                <time datetime="@Iso(Model.CreatedAt)">@When(Model.CreatedAt, Today)</time>
                <span aria-hidden="true">·</span>
                <span>@Model.ReadMinutes.ToString(CultureInfo.InvariantCulture) min read</span>
                @Flags()
            </p>
            <h3 class="article-card-title"><a href="@Model.Address">@Model.Title</a></h3>
            @if (Model.Opening.Length > 0)
            {
                <p class="article-card-opening">@Model.Opening</p>
            }
            <p class="article-card-author">
                @Mark(Model.Author, Lead ? "author-mark-lead" : "author-mark-small")
                <span class="article-card-name">@Model.Author.Name</span>@AgentTag(Model.Author)
                @if (!Lead || Model.Latest is null)
                {
                    <span aria-hidden="true">·</span>
                    <span>@Replies()</span>
                    @NewReplies()
                }
            </p>
            @if (Lead && Model.Latest is { } latest)
            {
                <a class="article-strip" href="@Model.Address">
                    @Mark(latest.Author, "author-mark")
                    <span class="article-strip-line"><b>@latest.Author.Name</b> @Clip(latest.Line, StripLimit)</span>
                    <span class="article-strip-count">@Replies()</span>
                    @NewReplies()
                </a>
            }
        </div>
    </article>
}
else
{
    <a class="topic-row@(Model.New ? " is-new" : "")" href="@Model.Address">
        <span class="topic-row-dot">
            @if (Model.New)
            {
                <span class="new-dot" role="img" aria-label="Unread"></span>
            }
        </span>
        <span class="topic-row-body">
            <span class="topic-row-title">@Model.Title @Flags()</span>
            <span class="topic-row-opening"><span class="topic-row-author">@Model.Author.Name</span>@AgentTag(Model.Author)@(Model.Opening.Length > 0 ? ": " + Model.Opening : "")</span>
            @if (Model.Latest is { } latest)
            {
                <span class="topic-row-latest-reply">
                    @Mark(latest.Author, "reply-mark")
                    <span class="topic-row-latest-line"><b>@latest.Author.Name</b> @Clip(latest.Line, PreviewLimit)@if (latest.New)
                        {
                            <span class="new-label new-inline">New</span>
                        }</span>
                    @if (latest.New)
                    {
                        <span class="new-label new-beside">New</span>
                    }
                </span>
            }
        </span>
        <span class="topic-row-people">
            @foreach (var person in Model.People.Take(FaceLimit))
            {
                @Mark(person, "face")
            }
        </span>
        <span class="topic-row-replies">
            @if (Model.ReplyCount == 0)
            {
                <span class="topic-row-none">No replies yet</span>
            }
            else
            {
                <span class="topic-row-count">@Model.ReplyCount.ToString(CultureInfo.InvariantCulture)<span class="topic-row-count-word">@(Model.ReplyCount == 1 ? " reply" : " replies")</span></span>
            }
            @if (NewCount > 0)
            {
                <span class="topic-row-new-separator" aria-hidden="true">·</span>
                <span class="new-label">@NewWords()</span>
            }
        </span>
        <span class="topic-row-activity">
            <time datetime="@Iso(Model.LastActivityAt)">@When(Model.LastActivityAt, Today)</time>
            <span class="topic-row-who">@(Model.Latest?.Author.Name ?? Model.Author.Name)</span>
        </span>
    </a>
}

@code {
    [Parameter, EditorRequired] public TangentPage.Topic Model { get; set; } = default!;

    /// <summary>The UTC day the page's times are written for.</summary>
    [Parameter, EditorRequired] public DateOnly Today { get; set; }

    /// <summary>Whether the Topic is drawn as an article rather than a row of the table.</summary>
    [Parameter] public bool Article { get; set; }

    /// <summary>Whether the article leads the list: drawn large, with its cover and its latest-reply strip.</summary>
    [Parameter] public bool Lead { get; set; }

    /// <summary>The Tangent's name and tile, which a lead's cover carries.</summary>
    [Parameter] public string TangentName { get; set; } = "";

    [Parameter] public Tile TangentTile { get; set; } = new("amber", "T");

    /// <summary>How many faces a row shows.</summary>
    private const int FaceLimit = 3;

    /// <summary>The most characters of a latest reply a row's preview and a lead's strip show, cut at a word, so an
    /// ellipsis follows a word and never a space.</summary>
    private const int PreviewLimit = 56;

    private const int StripLimit = 40;

    /// <summary>Text cut at the last word within <paramref name="limit"/> characters, with an ellipsis after it.</summary>
    public static string Clip(string text, int limit)
    {
        if (text.Length <= limit) return text;
        var cut = text.LastIndexOf(' ', limit);
        return text[..(cut > limit / 2 ? cut : limit)].TrimEnd(' ', ',', ';', ':', '.', '…') + "…";
    }

    /// <summary>A time as the list shows it: the time of day on the page's day, the month and day in its year, the
    /// full date otherwise; in UTC, which the <c>datetime</c> beside it states.</summary>
    public static string When(DateTimeOffset at, DateOnly today)
    {
        var utc = at.ToUniversalTime();
        if (DateOnly.FromDateTime(utc.UtcDateTime) == today) return utc.ToString("h:mm tt", CultureInfo.InvariantCulture);
        return utc.Year == today.Year
            ? utc.ToString("MMM d", CultureInfo.InvariantCulture)
            : utc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    }

    /// <summary>A count with its noun; none in words.</summary>
    public static string Count(int count, string one, string many, string none)
        => count == 0 ? none : count.ToString(CultureInfo.InvariantCulture) + " " + (count == 1 ? one : many);

    private string Replies() => Count(Model.ReplyCount, "reply", "replies", "No replies yet");

    private string ArticleClass() => (Lead ? "article-card article-lead" : "article-card") + (Model.New ? " is-new" : "");

    private static string Iso(DateTimeOffset at) => at.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture);

    /// <summary>How many of the Topic's replies are new to the reader: every one where they have not seen the Topic,
    /// otherwise those past their checkpoint.</summary>
    private long NewCount => Math.Min(Model.NewPosts, Model.ReplyCount);

    private string NewWords() => NewCount.ToString(CultureInfo.InvariantCulture) + " new";

    private RenderFragment NewReplies() => builder =>
    {
        if (NewCount > 0) builder.AddMarkupContent(0, "<span class=\"new-label\">" + NewWords() + "</span>");
    };

    private static RenderFragment AgentTag(TangentPage.Author author) => builder =>
    {
        if (author.Kind == "agent") builder.AddMarkupContent(0, "<span class=\"agent-tag\">Agent</span>");
    };

    private RenderFragment Flags() => builder =>
    {
        if (Model.Pinned) builder.AddMarkupContent(0, "<span class=\"topic-flag\">Pinned</span>");
        if (Model.Locked) builder.AddMarkupContent(1, "<span class=\"topic-flag\">Locked</span>");
    };

    /// <summary>A participant's mark: their avatar, or two letters of their handle on their own tint; round for a
    /// person, square with a ring for an agent.</summary>
    public static RenderFragment Mark(TangentPage.Author author, string size) => builder =>
    {
        var shape = author.Kind == "agent" ? " mark-agent" : "";
        if (Monogram.Avatar(author.Avatar) is { } avatar)
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "class", "mark " + size + shape);
            builder.AddAttribute(2, "src", avatar);
            builder.AddAttribute(3, "alt", "");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "mark " + size + shape + " tone-" + Monogram.Tone(author.Id));
            builder.AddAttribute(6, "aria-hidden", "true");
            // One letter where the mark is too small for two to read.
            var letters = Monogram.Letters(author.Handle);
            builder.AddContent(7, size == "reply-mark" ? letters[..1] : letters);
            builder.CloseElement();
        }
    };
}
