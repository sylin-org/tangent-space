@using Tangent.Connections
@* An article's line about its author's own account, shown to its author alone: the offer to publish it there, with not
   now the first time, or where it stands there, with its Bluesky post once it is out and their Connections page; for an
   article no longer public here or removed, that its copy is still out there, and what takes it down. *@
@if (Model is { } line)
{
    <div class="door-offer bar offer publish-line" data-state="@line.State">
        <p class="door-offer-line">
            @line.Sentence
            @if (line.Detail is { } detail)
            {
                <span class="topic-row-none">@(" " + detail)</span>
            }
        </p>
        <div class="door-offer-answers">
            @if (line.Publish is { } publish)
            {
                <form class="publish" method="post" action="@publish.Action">
                    <button type="submit" class="tangent-new">@(line.Publishes ? "Publish" : "Grant it again")</button>
                </form>
            }
            @if (line.NotNow is { } notNow)
            {
                <form class="not-now" method="post" action="@notNow.Action">
                    <input type="hidden" name="@PublishController.BackField" value="@notNow.Value(PublishController.BackField)">
                    <button type="submit" class="button">Not now</button>
                </form>
            }
            @if (line.Elsewhere is { } elsewhere)
            {
                <a class="button" href="@elsewhere" rel="noopener noreferrer">View on Bluesky</a>
            }
            @if (line.State != Publishing.Offer)
            {
                <a class="button" href="@line.Connections">Connections</a>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Connections.Publishing Model { get; set; } = default!;
}
