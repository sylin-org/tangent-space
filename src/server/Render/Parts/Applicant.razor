@* One application: who, linked to their profile, their handle, when they applied and whether they were declined, and what
   the reader may decide of it. *@
<p class="door-offer-line">
    <a href="@Model.Profile">@Model.Name</a> @("@" + Model.Handle)
    <span class="topic-row-none">· applied @Wording.When(Model.AppliedAt, Today)@(Model.State == Participants.ApplicationsPage.Declined ? " · declined" : "")</span>
</p>
@if (Model.Admit is not null || Model.Decline is not null)
{
    <div class="door-offer-answers">
        <Draw Part="@Model.Admit" />
        <Draw Part="@Model.Decline" />
    </div>
}

@code {
    [Parameter, EditorRequired] public Participants.ApplicationsPage.Applicant Model { get; set; } = default!;

    [CascadingParameter(Name = Page.TodayValue)] public DateOnly Today { get; set; }
}
