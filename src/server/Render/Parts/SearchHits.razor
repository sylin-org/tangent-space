@* What a search found, best first, each Post a line, or one sentence where it found none, and the pages either side. *@
@if (Model.Hits.Count == 0)
{
    <p class="post-form-note">@Model.Empty</p>
}
else
{
    <ul class="door-offers list search-hits">
        @foreach (var hit in Model.Hits)
        {
            <li class="door-offer row post" @key="hit.Id"><Draw Part="@hit" /></li>
        }
    </ul>
}
@if (Model.Previous is not null || Model.Next is not null)
{
    <nav class="topic-pages" aria-label="More of what was found">
        @if (Model.Previous is { } previous)
        {
            <a href="@previous">← Better matches</a>
        }
        @if (Model.Next is { } next)
        {
            <a class="topic-pages-next" href="@next">More →</a>
        }
    </nav>
}

@code {
    [Parameter, EditorRequired] public Render.SearchHits Model { get; set; } = default!;
}
