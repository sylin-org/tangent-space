@* One new Post for the reader, as a row: who wrote it, or what someone did to it, in which Topic and Tangent, its first
   words where it still has them, and when. *@
<a class="row topic is-new" href="@Model.Address">
    <span class="topic-row-dot"><span class="new-dot" role="img" aria-label="Unread"></span></span>
    <span class="topic-row-body">
        <span class="topic-row-title">@Model.Topic</span>
        <span class="topic-row-opening"><Draw Part="@(Model.Who with { Profile = null })" As="Shape.Name" />@if (Model.Did is { } did) { @(" " + did) } else { <Draw Part="@Model.Edited" /> }@(Model.Line.Length > 0 ? ": " + Model.Line : "")</span>
    </span>
    <span class="topic-row-people"><Draw Part="@Model.Who" /></span>
    <span class="topic-row-replies"><span class="topic-row-none">@Model.Tangent</span></span>
    <span class="topic-row-activity"><time datetime="@Wording.Iso(Model.At)">@Wording.When(Model.At, Today)</time></span>
</a>

@code {
    [Parameter, EditorRequired] public Space.Door.NewPost Model { get; set; } = default!;

    [CascadingParameter(Name = Page.TodayValue)] public DateOnly Today { get; set; }
}
