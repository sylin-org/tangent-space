@using System.Globalization
@* The ways a Tangent's page lists its Topics: all of them, marked current unless the page continues further back; and in an
   articles Tangent, where the page's articles differ, the months and authors the filter island narrows them to. *@
<h2 class="rail-heading">@(Articles ? "Articles" : "Topics")</h2>
<ul class="rail-views list">
    <li><a href="@Model.Tangent.Address" aria-current="@(Model.Continued ? null : "page")">@(Articles ? "All articles" : "All topics")</a></li>
</ul>
@if (Articles && !Standalone && (Months.Count > 1 || Authors.Count > 1))
{
    <div class="article-filter" hidden data-island="filter">
        @if (Months.Count > 1)
        {
            <h2 class="rail-heading rail-heading-spaced">By month</h2>
            <ul class="rail-views list">
                @foreach (var month in Months)
                {
                    <li><button type="button" class="article-filter-choice" data-month="@month.Key" aria-pressed="false">@month.Name<span class="article-filter-count">@month.Count.ToString(CultureInfo.InvariantCulture)</span></button></li>
                }
            </ul>
        }
        @if (Authors.Count > 1)
        {
            <h2 class="rail-heading rail-heading-spaced">By author</h2>
            <ul class="rail-views list">
                @foreach (var author in Authors)
                {
                    <li><button type="button" class="article-filter-choice" data-author="@author.Key" aria-pressed="false">@author.Name<span class="article-filter-count">@author.Count.ToString(CultureInfo.InvariantCulture)</span></button></li>
                }
            </ul>
        }
        <p class="article-filter-note" role="status"></p>
    </div>
}

@code {
    [Parameter, EditorRequired] public Render.TopicViews Model { get; set; } = default!;

    [CascadingParameter(Name = nameof(Shell.Standalone))] public bool Standalone { get; set; }

    private bool Articles => Model.Tangent.Kind == "article";

    /// <summary>One way the filter narrows the list: its key, its name and how many it holds.</summary>
    private sealed record Choice(string Key, string Name, int Count);

    private IReadOnlyList<Choice> Months => Model.Topics
        .GroupBy(topic => topic.CreatedAt.ToUniversalTime().ToString("yyyy-MM", CultureInfo.InvariantCulture))
        .OrderByDescending(month => month.Key, StringComparer.Ordinal)
        .Select(month => new Choice(month.Key, month.First().CreatedAt.ToUniversalTime().ToString("MMMM yyyy", CultureInfo.InvariantCulture), month.Count()))
        .ToList();

    private IReadOnlyList<Choice> Authors => Model.Topics
        .GroupBy(topic => topic.Author.Id, StringComparer.Ordinal)
        .Select(author => new Choice(author.Key, author.First().Author.Name, author.Count()))
        .OrderByDescending(author => author.Count).ThenBy(author => author.Name, StringComparer.CurrentCulture)
        .ToList();
}
