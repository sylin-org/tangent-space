@* Why the reader may not write in the place, in one line: their application waits or was declined, or they are timed out,
   until when. *@
@if (Model.Gate == Access.Capabilities.TimedOut.Word && Model.Until is { } until)
{
    <div class="door-offer door-application bar participant is-you" data-gate="@Model.Gate">
        <p class="door-offer-line">You’re timed out until <time datetime="@Wording.Iso(until)">@Wording.Until(until)</time>: you can read and report here, and post again then.</p>
    </div>
}
else
{
    <div class="@(Model.Gate == Access.Capabilities.Apply.Word ? "door-offer door-application bar application is-waiting" : "door-offer door-application bar application")" data-gate="@Model.Gate">
        <p class="door-offer-line">@Access.Capabilities.Sentence(Model.Gate)</p>
    </div>
}

@code {
    [Parameter, EditorRequired] public Render.StandingLine Model { get; set; } = default!;
}
