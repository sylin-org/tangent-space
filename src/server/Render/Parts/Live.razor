@using System.Text.Json
@using Koan.Web.Hosting
@inject Events.PagePosition Position
@inject KoanWebBaseUrl BaseUrl
@inject IHttpContextAccessor Http
@* The live updater's island, one per page: it streams the log from where the page's request found it and patches the
   page as rows that concern it arrive — on a Topic, a new reply appended at the newest window or announced by the
   notice below the replies, and a Post edited or removed fetched again in place; on a Tangent, its list of Topics;
   on the door, the door. It never moves a checkpoint. A page standing alone has no log to stream, and none of it. *@
@if (!Standalone)
{
    <div class="live" data-island="live" data-props="@Props()">
        @if (Model.Page == LiveUpdates.TopicPage)
        {
            <nav class="topic-pages" aria-live="polite" hidden>
                <a class="topic-pages-next" href="@Model.Address">New replies →</a>
            </nav>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public LiveUpdates Model { get; set; } = default!;

    [CascadingParameter(Name = nameof(Shell.Standalone))] public bool Standalone { get; set; }

    private long? _since;

    protected override async Task OnInitializedAsync()
    {
        if (!Standalone) _since = await Position.Since(CancellationToken.None);
    }

    private string Props()
    {
        var address = BaseUrl.Resolve(Http.HttpContext ?? throw new InvalidOperationException("The live updater renders inside a request."));
        return JsonSerializer.Serialize(new
        {
            events = address + Events.EventsController.Path,
            door = address + "/",
            since = _since,
            page = Model.Page,
            tangent = Model.Tangent,
            topic = Model.Topic,
            address = Model.Address,
            newest = Model.Newest
        });
    }
}
