@* A sentence whose code is set between backticks, as a pointer's sentence carries it: the code reads in the mono
   face, breaking only after slashes. *@
@for (var index = 0; index < Pieces.Length; index++)
{
    if (index % 2 == 1)
    {
        <Draw Part="@(new Render.Code(Pieces[index]))" />
    }
    else
    {
        @Pieces[index]
    }
}

@code {
    [Parameter, EditorRequired] public Render.CodedSentence Model { get; set; } = default!;

    private string[] Pieces => Model.Text.Split('`');
}
