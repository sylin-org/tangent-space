@using System.Globalization
@* The asks to join one members-only Tangent the reader manages, in an Offer's line, "at least" where the door stopped
   counting, with the way to its people. *@
<div class="door-offer door-applications bar application is-waiting">
    <p class="door-offer-line">@(Model.Count == 1 && !Model.AtLeast ? "Someone asks" : (Model.AtLeast ? "At least " : "") + Model.Count.ToString(CultureInfo.InvariantCulture) + " people ask") to join @Model.Tangent.</p>
    <div class="door-offer-answers">
        <a class="tangent-new" href="@Model.Address">People</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Space.Door.Asking Model { get; set; } = default!;
}
