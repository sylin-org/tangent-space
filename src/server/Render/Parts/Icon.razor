@* A menu item's 16px icon, drawn in the text's colour and hidden from assistive technology. *@
@if (Paths.TryGetValue(Model.Name, out var paths))
{
    <svg class="menu-icon" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)paths)</svg>
}

