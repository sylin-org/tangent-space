@using Tangent.Posts
@using global::Tangent.Tangents
@* The form that edits a Post: one panel in the page, naming the Topic, with the title on a root and the body, and the
   version the editor read riding in a hidden field. Below it, for a reader who may remove the Post, the removal waits
   behind a disclosure that says what removing does and holds the one button that does it: the confirmation is in the
   page, never a dialog. A reader who may not edit reads why above the form, whose fields are read-only and which has
   no button; a tombstone says it is removed and holds nothing to change. After an edit made from another version the
   fields hold the current text, and the words that were not saved stay below them to copy from. Words someone other
   than the author last edited say who, above the form. *@
@if (Writing && Page.Edit is { } writing && Page.Author is { } author)
{
    <Draw Part="@(new Render.ArticleEditor
    {
        Tool = "edit", Heading = "Edit article", TangentAddress = Page.TangentAddress, Action = writing.Action, Author = author, At = Page.CreatedAt, Door = Page.Door, TitleId = "edit-title",
        BodyId = "edit-body", Island = "submitting", Bring = Page.Bring, Participant = Page.Who?.Id,
        EditScope = "edit:" + Page.Id + ":" + Page.Version.ToString(System.Globalization.CultureInfo.InvariantCulture), Topic = Page.TopicSlug,
        Title = Page.Title, Body = Page.Body, CoverId = Page.CoverId, Minutes = TangentPage.ReadTime(Page.Body), Failure = Page.Failure,
        FailureGate = Page.FailureGate, TitleFailure = Page.TitleFailure, BodyFailure = Page.BodyFailure,
        Hidden = Versioned(writing), Below = Unsaved, Actions = Saving, After = Removing
    })" />
}
else
{
            <p class="post-form-where">In <a href="@Page.TopicAddress">@Page.TopicTitle</a></p>
            <h1 id="edit-heading" class="sign-in-title">@(!Page.Root ? "Edit post" : Page.Kind == PostWrites.Word(PostKind.Article) ? "Edit article" : "Edit topic")</h1>
            @if (Page.Edited is { } edited)
            {
                <p class="post-form-note">Last edited by @edited.By.Name.</p>
            }
            @if (Page.Failure is { } failure)
            {
                <p class="sign-in-failure" id="edit-failure" role="alert" data-gate="@Page.FailureGate">@failure</p>
            }
            else if (Page.Gate is { } gate)
            {
                <p class="sign-in-failure" id="edit-failure" role="alert" data-gate="@gate">
                    @if (Page.SignIn is { } signIn)
                    {
                        @(Access.Capabilities.Sentence(gate) + " ")<a href="@signIn">Sign in</a>
                    }
                    else
                    {
                        @Access.Capabilities.Sentence(gate)
                    }
                </p>
            }
            @if (!Page.Removed)
            {
                <form class="sign-in-form edit" method="post" action="@Page.Edit?.Action" data-island="submitting">
                    @if (Page.Edit is { } edit)
                    {
                        <input type="hidden" name="@PostWrites.VersionField" value="@edit.Value(PostWrites.VersionField)">
                    }
                    @if (Page.Root)
                    {
                        <div class="field">
                            <label class="field-label" for="edit-title">Title</label>
                            <span class="field-input">
                                <input id="edit-title" name="@PostWrites.TitleField" type="text" required maxlength="@Posts.Post.TitleLimit" autocomplete="off"
                                       autofocus="@(Page.Gate is null && Focus == "edit-title")" readonly="@(Page.Gate is not null)" value="@Page.Title"
                                       aria-invalid="@(Page.TitleFailure is null ? "false" : "true")"
                                       aria-describedby="@(Page.TitleFailure is null ? null : "edit-title-failure")">
                            </span>
                            @if (Page.TitleFailure is { } titleFailure)
                            {
                                <p class="field-failure" id="edit-title-failure">@titleFailure</p>
                            }
                        </div>
                    }
                    <div class="field post-body-field" data-island="@(Page.Gate is null && Page.Edit is not null ? "article" : null)" data-props="@EditorProps()">
                        <label class="field-label" for="edit-body">Post</label>
                        <textarea class="post-form-body" id="edit-body" name="@PostWrites.BodyField" rows="12" required="@(!Page.BodyOptional)"
                                  autofocus="@(Page.Gate is null && Focus == "edit-body")" readonly="@(Page.Gate is not null)"
                                  aria-invalid="@(Page.BodyFailure is null ? "false" : "true")"
                                  aria-describedby="@(Page.BodyFailure is null ? null : "edit-body-failure")">@Page.Body</textarea>
                        @if (Page.BodyFailure is { } bodyFailure)
                        {
                            <p class="field-failure" id="edit-body-failure">@bodyFailure</p>
                        }
                    </div>
                    @if (Page.SentBody is { } sentBody)
                    {
                        <div class="field post-form-unsaved">
                            <label class="field-label" for="edit-sent">Your words, not saved</label>
                            @if (Page.SentTitle is { } sentTitle)
                            {
                                <p class="post-form-unsaved-title">@sentTitle</p>
                            }
                            <textarea class="post-form-body" id="edit-sent" rows="6" readonly>@sentBody</textarea>
                        </div>
                    }
                    @if (Page.Gate is null)
                    {
                        <div class="post-form-actions">
                            <a class="post-form-cancel" href="@Page.Address">Cancel</a>
                            <button type="submit" class="sign-in-submit post-form-submit" data-busy-label="Saving…">Save</button>
                        </div>
                    }
                </form>
                @if (Page.Remove is { } remove)
                {
                    <details class="post-remove">
                        <summary class="post-remove-toggle">@(Page.Root ? "Remove this topic’s opening post" : "Remove this post")</summary>
                        <div class="post-remove-confirm">
                            <p class="post-remove-note">
                                @if (Page.Root)
                                {
                                    <text>Its words leave the page and a tombstone stays in their place; the topic’s replies stay as they are.</text>
                                }
                                else
                                {
                                    <text>Its words leave the page and a tombstone stays in their place.</text>
                                }
                            </p>
                            <form class="remove" method="post" action="@remove.Action">
                                <button type="submit" class="post-remove-submit">Remove</button>
                            </form>
                        </div>
                    </details>
                }
            }
}

@code {
    [Parameter, EditorRequired] public Render.EditForm Model { get; set; } = default!;

    private EditPage Page => Model.Page;

    /// <summary>What an article's edit carries unseen: the version it was read at.</summary>
    private RenderFragment Versioned(Render.Form writing) => @<text><input type="hidden" name="@PostWrites.VersionField" value="@writing.Value(PostWrites.VersionField)"></text>;

    /// <summary>Under an article's edit: who last edited it, and the words sent that were not saved.</summary>
    private RenderFragment Unsaved => @<text>
        @if (Page.Edited is { } edited)
        {
            <p class="post-form-note">Last edited by @edited.By.Name.</p>
        }
        @if (Page.SentBody is { } sentBody)
        {
            <div class="field post-form-unsaved">
                <label class="field-label" for="edit-sent">Your words, not saved</label>
                @if (Page.SentTitle is { } sentTitle)
                {
                    <p class="post-form-unsaved-title">@sentTitle</p>
                }
                <textarea class="post-form-body" id="edit-sent" rows="6" readonly>@sentBody</textarea>
            </div>
        }
    </text>;

    /// <summary>The way back from an article's edit, and its button.</summary>
    private RenderFragment Saving => @<text>
        <a class="post-form-cancel" href="@Page.Address">Cancel</a>
        <button type="submit" class="sign-in-submit post-form-submit" data-busy-label="Saving…">Save</button>
    </text>;

    /// <summary>After an article's edit, removing it, confirmed in the page.</summary>
    private RenderFragment Removing => @<text>
        @if (Page.Remove is { } remove)
        {
            <details class="post-remove">
                <summary class="post-remove-toggle">Remove this article</summary>
                <div class="post-remove-confirm">
                    <p class="post-remove-note">Its words leave the page and a tombstone stays in their place; its replies stay as they are.</p>
                    <form class="remove" method="post" action="@remove.Action">
                        <button type="submit" class="post-remove-submit">Remove</button>
                    </form>
                </div>
            </details>
        }
    </text>;



    /// <summary>Whether this is an article that stands, edited in the article's own layout.</summary>
    /// <summary>The editor's props, for an editor who may edit: where the place's images live, where a picture is brought
    /// in, whose draft of this version it keeps, and where the suggestions of this Topic are read.</summary>
    private string? EditorProps() => Page.Gate is null && Page.Edit is not null
        ? System.Text.Json.JsonSerializer.Serialize(new
        {
            door = Page.Door,
            bring = Page.Bring?.Action,
            participant = Page.Who?.Id,
            edit = Page.Who is null ? null : "edit:" + Page.Id + ":" + Page.Version.ToString(System.Globalization.CultureInfo.InvariantCulture),
            suggest = SuggestionsController.Address(Page.TangentAddress, Page.TopicSlug),
            post = true
        })
        : null;

    private bool Writing => Page.Root && !Page.Removed && Page.Kind == PostWrites.Word(PostKind.Article);

    /// <summary>The field the page opens on: the first one a refusal concerns, else the first there is.</summary>
    private string Focus => Page.Root && (Page.TitleFailure is not null || Page.BodyFailure is null) ? "edit-title" : "edit-body";

    /// <summary>The frame the shell draws around the page: the place; the Tangent and the form as crumbs, the Topic
    /// named in the panel; and who reads, or where a visitor signs in.</summary>
    public static Frame Frame(EditPage page)
        => new(page.Place, page.Door,
            [new Crumb(!page.Root ? "Edit post" : page.Kind == PostWrites.Word(PostKind.Article) ? "Edit article" : "Edit topic")],
            page.Who, page.SignIn);
}
