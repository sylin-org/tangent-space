@* A panel's title: where it stands, with its links, its heading, and the sentence under it. *@
@if (Model.Where is { } where)
{
    <p class="post-form-where"><Draw Part="@(new Render.Sentence(where))" As="Shape.Inline" /></p>
}
<h1 class="sign-in-title">@Model.Title</h1>
@if (Model.Lede is { } lede)
{
    <p class="sign-in-lede"><Draw Part="@(new Render.Sentence(lede))" As="Shape.Inline" /></p>
}

@code {
    [Parameter, EditorRequired] public Render.PanelTitle Model { get; set; } = default!;
}
