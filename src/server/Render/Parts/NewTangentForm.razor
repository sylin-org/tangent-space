@using Tangent.Tangents
@using global::Tangent.Posts
@using global::Tangent.Render
@* The form that creates a Tangent: one panel in the page that asks for a name. What else a Tangent has stands at its
   default, behind one quiet line that opens in place to the description, the kind and the audience, each a choice the
   person may change; it opens by itself when a refusal concerns one of them or one was changed. A reader who may not
   create a Tangent reads why above the form, whose fields are read-only and which has no button, and a visitor the way
   to sign in; a refusal of a field shows under that field, and any other above the form. *@
<p class="post-form-where">In <a href="@Page.Door">@Page.Place</a></p>
<h1 id="new-tangent-heading" class="sign-in-title">New Tangent</h1>
@if (Page.Gate is { } gate)
{
    <p class="sign-in-failure" id="new-tangent-failure" role="alert" data-gate="@gate">
        @if (Page.SignIn is { } signIn)
        {
            @(Access.Capabilities.Sentence(gate) + " ")<a href="@signIn">Sign in</a>
        }
        else
        {
            @Access.Capabilities.Sentence(gate)
        }
    </p>
}
else if (Page.Failure is { } failure)
{
    <p class="sign-in-failure" id="new-tangent-failure" role="alert">@failure</p>
}
<form class="sign-in-form create-tangent" method="post" action="@Page.Create?.Action" data-island="@(Page.Gate is null ? "submitting" : null)">
    @if (Page.Create is { } create)
    {
    }
    <div class="field">
        <label class="field-label" for="new-tangent-name">Name</label>
        <span class="field-input">
            <input id="new-tangent-name" name="@TangentWrites.NameField" type="text" required maxlength="@Tangent.NameLimit" autocomplete="off"
                   autofocus="@(Page.Gate is null && Page.DescriptionFailure is null)" readonly="@(Page.Gate is not null)" value="@Page.Name"
                   placeholder="The workshop"
                   aria-invalid="@(Page.NameFailure is null ? "false" : "true")"
                   aria-describedby="@(Page.NameFailure is null ? null : "new-tangent-name-failure")">
        </span>
        @if (Page.NameFailure is { } nameFailure)
        {
            <p class="field-failure" id="new-tangent-name-failure">@nameFailure</p>
        }
    </div>
    <Draw Part="@(new Render.TangentChoices("new-tangent", Page.Description, Page.Kind, Page.Audience, Page.Kinds, Page.Audiences, Page.DescriptionFailure, Page.Gate is not null, true, null))" />
    @if (Page.Gate is null)
    {
        <div class="post-form-actions">
            @if (Page.Who is { } who)
            {
                <span class="post-form-as">Created by <strong>@("@" + who.Handle)</strong></span>
            }
            <button type="submit" class="sign-in-submit post-form-submit" data-busy-label="Creating…">Create</button>
        </div>
    }
</form>

@code {
    [Parameter, EditorRequired] public Render.NewTangentForm Model { get; set; } = default!;

    private NewTangentPage Page => Model.Page;

    /// <summary>The frame the shell draws around the page: the place and the form as crumbs, and who reads, or where a
    /// visitor signs in.</summary>
    public static Frame Frame(NewTangentPage page)
        => new(page.Place, page.Door, [new Crumb("New Tangent")], page.Who, page.SignIn);
}
