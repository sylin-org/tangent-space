@using System.Text.Json
@using Microsoft.Extensions.Options
@using Tangent.Space
@inject IOptions<TangentSpaceOptions> Options
@* The fragment island: the door reads as rendered here, and once the page script mounts it, it can refresh
   itself from this component alone at the door's URL, from the configured base URL the shell's links use. *@
<main data-island="fragment" data-props="@JsonSerializer.Serialize(new { url = Options.Value.BaseUrl + "/" })">
    <h1>@Model.Name</h1>
    <p><a href="@Model.BaseUrl">@Model.BaseUrl</a></p>
</main>

@code {
    [Parameter, EditorRequired] public Door Model { get; set; } = default!;
}
