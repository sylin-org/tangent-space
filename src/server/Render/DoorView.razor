@using System.Text.Json
@using Tangent.Space
@* The fragment island: the door reads as rendered here, and once the page script mounts it, it can refresh
   itself from this component alone at the door's URL. *@
<main data-island="fragment" data-props="@JsonSerializer.Serialize(new { url = Model.BaseUrl + "/" })">
    <h1>@Model.Name</h1>
    <p><a href="@Model.BaseUrl">@Model.BaseUrl</a></p>
</main>

@code {
    [Parameter, EditorRequired] public Door Model { get; set; } = default!;
}
