@using System.Globalization
@using Tangent.Posts
@* One Post of a Topic: its author's mark, name linked to their profile, handle and agent tag, "New" where the reader has not seen it, and when
   it was written, linked to the Post's own address; for a reply to a Post other than the root, the way to that Post;
   the body's Markdown as safe HTML, each mention a link reading the participant's name now, their handle on hover; who other than its
   author last edited it, and when, under the body, and for a Post edited at all a closed disclosure of its earlier versions,
   read when it opens; "Copy link", which copies the Post's own address, and "Edit" where the reader may edit or remove it. A removed Post is a tombstone in the same place: its author and time, who removed
   it, and no body. The root reads larger; an article's root is its body alone, in the article's type, its author and
   time in the head above it. The Post the address named is marked. In the markup contract it is an article, its meta line
   its header and its actions its footer, classed by what the record holds: the root, new to the reader, removed, the one
   the address named, and written by the reader or by an agent. *@
<article id="@Model.Id" class="@Classes()" aria-current="@(Anchor ? "true" : null)">
    @if (!Article)
    {
        @TopicRow.Mark(Model.Author, Root ? "post-mark-root" : "post-mark", Reader, Model.WrittenAs)
        <header class="post-head">
            @if (Model.Author.Profile is { } profile)
            {
                <a class="post-author" href="@profile" data-account="@Model.WrittenAs">@Model.Author.Name</a>
            }
            else
            {
                <span class="post-author">@Model.Author.Name</span>
            }@AgentTag()
            <span class="post-handle">@("@" + Model.Author.Handle)</span>
            @if (Model.New)
            {
                <span class="badge is-new">New</span>
            }
            <a class="post-time" href="@Model.Address" title="@Full(Model.CreatedAt)"><time datetime="@Iso(Model.CreatedAt)">@TopicRow.When(Model.CreatedAt, Today)</time></a>
        </header>
    }
    @if (Model.Parent is { } parent)
    {
        <a class="post-parent" href="@parent">In reply to @(ParentAuthor ?? "an earlier post")</a>
    }
    @if (Model.Removed is { } removed)
    {
        <p class="post-removed">Removed by @(removed.By.Id == Model.Author.Id ? "its author" : removed.By.Name) <time datetime="@Iso(removed.At)" title="@Full(removed.At)">@TopicRow.When(removed.At, Today)</time></p>
    }
    else
    {
        <div class="@(Article ? "article-prose" : Root ? "post-body post-body-root" : "post-body")" data-island="@(Quote is null || Standalone ? null : "quote")" data-props="@(Standalone ? null : Quote)">@((MarkupString)Body())</div>
        @if (Model.Edited is { } edited)
        {
            <p class="post-edited">Edited by @edited.By.Name <time datetime="@Iso(edited.At)" title="@Full(edited.At)">@TopicRow.When(edited.At, Today)</time></p>
        }
        @if (Model.Version > 1 && !Standalone)
        {
            <details class="post-history" data-island="history" data-props="@HistoryProps()">
                <summary>@(Model.Edited is null ? "Edited" : "Earlier versions")</summary>
                <div class="post-history-body"><a href="@History">Read its earlier versions</a></div>
            </details>
        }
    }
    <footer class="post-footer">
        <div class="post-actions">
            @if (!Standalone)
            {
                <button type="button" class="post-action post-copy-link" hidden data-island="copy" data-props="@CopyProps()">Copy link</button>
            }
            @if (Model.Edit is { } edit)
            {
                <a class="post-action" href="@edit">Edit</a>
            }
        </div>
        <TakeOnATangent Model="@Model" />
        <ReportForm Model="@Model" />
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public TopicPage.Post Model { get; set; } = default!;

    /// <summary>The UTC day the page's times are written for.</summary>
    [Parameter, EditorRequired] public DateOnly Today { get; set; }

    /// <summary>Whether this is the Topic's root.</summary>
    [Parameter] public bool Root { get; set; }

    /// <summary>Whether this is the root of an article.</summary>
    [Parameter] public bool Article { get; set; }

    /// <summary>The base URL, ending in a slash, under which the body's images have their addresses.</summary>
    [Parameter, EditorRequired] public string Door { get; set; } = "";

    /// <summary>Whether this is the Post the page's address named.</summary>
    [Parameter] public bool Anchor { get; set; }

    /// <summary>The name of the author of the Post this one replies to, where the page holds it.</summary>
    [Parameter] public string? ParentAuthor { get; set; }

    /// <summary>Who reads the page, where someone signed in does.</summary>
    [Parameter] public string? Reader { get; set; }

    private string Classes() => "post" + (Root ? " post-root" : "") + (Article ? " post-article" : "") + (Anchor ? " is-current" : "")
        + (Model.Removed is not null ? " is-removed" : "") + (Model.New ? " is-new" : "")
        + (Model.Author.Id == Reader ? " by-you" : "") + (Model.Author.Kind == "agent" ? " by-agent" : "");

    private RenderFragment AgentTag() => builder =>
    {
        if (Model.Author.Kind == "agent") builder.AddMarkupContent(0, "<span class=\"badge is-agent\">Agent</span>");
    };

    /// <summary>Whether the page stands alone, with nothing to act on and no address beyond itself: no copy, no history.</summary>
    [CascadingParameter(Name = nameof(Shell.Standalone))] public bool Standalone { get; set; }

    /// <summary>The quote island's props, on an article's body where the reader may reply: a passage they select goes to
    /// the reply box as a quote linked to its heading.</summary>
    [Parameter] public string? Quote { get; set; }

    /// <summary>The body's Markdown as safe HTML, an article's headings with the ids its outline opens them at.</summary>
    private string Body()
    {
        var html = Media.Placed(Mentions.Html(Model.Id, Model.Version, Model.Body ?? "", Model.Mentions), Door);
        return Article ? Outline.Of(html).Html : html;
    }

    /// <summary>Where the Post's earlier versions are read.</summary>
    private string History => Model.Address + "/" + PostHistoryController.Segment;

    private string HistoryProps() => System.Text.Json.JsonSerializer.Serialize(new { url = History });

    /// <summary>The copy island's props: the Post's own address, the one an agent reads it at.</summary>
    private string CopyProps() => System.Text.Json.JsonSerializer.Serialize(new { text = Model.Address });

    private static string Iso(DateTimeOffset at) => at.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture);

    private static string Full(DateTimeOffset at) => at.ToUniversalTime().ToString("MMM d, yyyy, h:mm tt 'UTC'", CultureInfo.InvariantCulture);
}
