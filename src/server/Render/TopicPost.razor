@using System.Globalization
@using Tangent.Posts
@* One Post of a Topic: its author's mark, name, handle and agent tag, "New" where the reader has not seen it, and when
   it was written, linked to the Post's own address; for a reply to a Post other than the root, the way to that Post;
   the body's Markdown as safe HTML, each mention a link reading the participant's current handle; and "Edit" where
   the reader may edit or remove it. A removed Post is a tombstone in the same place: its author and time, who removed
   it, and no body. The root reads larger. The Post the address named is marked. *@
<article id="@Model.Id" class="@Classes()" aria-current="@(Anchor ? "true" : null)">
    @TopicRow.Mark(Model.Author, Root ? "post-mark-root" : "post-mark")
    <div class="post-main">
        <div class="post-head">
            <span class="post-author">@Model.Author.Name</span>@AgentTag()
            <span class="post-handle">@("@" + Model.Author.Handle)</span>
            @if (Model.New)
            {
                <span class="new-label">New</span>
            }
            <a class="post-time" href="@Model.Address" title="@Full(Model.CreatedAt)"><time datetime="@Iso(Model.CreatedAt)">@TopicRow.When(Model.CreatedAt, Today)</time></a>
        </div>
        @if (Model.Parent is { } parent)
        {
            <a class="post-parent" href="@parent">In reply to @(ParentAuthor ?? "an earlier post")</a>
        }
        @if (Model.Removed is { } removed)
        {
            <p class="post-removed">Removed by @(removed.By.Id == Model.Author.Id ? "its author" : removed.By.Name) <time datetime="@Iso(removed.At)" title="@Full(removed.At)">@TopicRow.When(removed.At, Today)</time></p>
        }
        else
        {
            <div class="@(Root ? "post-body post-body-root" : "post-body")">@((MarkupString)Mentions.Html(Model.Id, Model.Version, Model.Body ?? "", Model.Mentions))</div>
        }
        @if (Model.Edit is { } edit)
        {
            <div class="post-actions">
                <a class="post-action" href="@edit">Edit</a>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public TopicPage.Post Model { get; set; } = default!;

    /// <summary>The UTC day the page's times are written for.</summary>
    [Parameter, EditorRequired] public DateOnly Today { get; set; }

    /// <summary>Whether this is the Topic's root.</summary>
    [Parameter] public bool Root { get; set; }

    /// <summary>Whether this is the Post the page's address named.</summary>
    [Parameter] public bool Anchor { get; set; }

    /// <summary>The name of the author of the Post this one replies to, where the page holds it.</summary>
    [Parameter] public string? ParentAuthor { get; set; }

    private string Classes() => "post" + (Root ? " post-root" : "") + (Anchor ? " is-anchor" : "")
        + (Model.Removed is not null ? " is-removed" : "") + (Model.New ? " is-new" : "");

    private RenderFragment AgentTag() => builder =>
    {
        if (Model.Author.Kind == "agent") builder.AddMarkupContent(0, "<span class=\"agent-tag\">Agent</span>");
    };

    private static string Iso(DateTimeOffset at) => at.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture);

    private static string Full(DateTimeOffset at) => at.ToUniversalTime().ToString("MMM d, yyyy, h:mm tt 'UTC'", CultureInfo.InvariantCulture);
}
