@using System.Globalization
@using System.Text.Json
@using Tangent.Space
@* The page around one resource's component: the place's accent on <html>, and the stylesheet and the two scripts every page loads, absolute from
   the base URL. The theme script blocks in <head> so the reader's theme applies before the first paint; the
   page script is a module, deferred by nature, that mounts the islands once the document is parsed. A standalone page
   opens with no server and no script: the device decides its theme, and no island answers on it. A resource
   that names a frame is drawn inside it: the masthead with the place's mark and name, the search box, a form that works without JavaScript and suggests as someone types with it, and, for someone signed in, how
   many of their notifications they have not seen, linked to them and shown only while there are some, which the page's
   stream raises as new ones arrive, and their account opening in the page with their name, handle and role, their
   notifications, the place's settings for whoever may change them, and the way to sign out, or for a visitor the way to
   sign in; the path bar whose elbow hangs from the mark, with a Tangent's crumb opening the list of Tangents
   in the page, and where a new one is created for whoever may; and the footer with the appearance a visitor can choose. A page a visitor may
   read carries in its head the card a link to it previews. A page of the place's archive opens with the one line that says it is retired. The place's own
   slots come through here: its head last in <head>, so what it sets wins, its masthead after the place's name and its footer first in the footer, each adding nothing while it is empty.
   Nothing here is a dialog. *@
<!DOCTYPE html>
<html lang="en" data-accent="@Accent">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title</title>
    <link rel="stylesheet" href="@(BaseUrl + "/" + HtmlFormatter.Stylesheet)">
    @if (!Standalone)
    {
        <script src="@(BaseUrl)/theme.js"></script>
        <script type="module" src="@(BaseUrl)/tangent.js"></script>
    }
    @foreach (var feed in Frame?.Feeds ?? [])
    {
        <link rel="alternate" type="@feed.Type" title="@feed.Title" href="@feed.Address">
    }
    @if (Card is not null)
    {
        @((MarkupString)Card)
    }
    @if (Slots.Head.Length > 0)
    {
        @((MarkupString)Slots.Head)
    }
</head>
<body>
@if (Retired is { } retired)
{
    <p class="retired-line">@retired</p>
}
@if (Frame is { } frame)
{
    <header class="masthead">
        <a class="masthead-place" href="@frame.Door">
            <span class="masthead-mark" aria-hidden="true">@frame.Initial</span>
            <span class="masthead-name">@frame.Place</span>
        </a>
        <Slot Name="masthead" Html="@Slots.Masthead" />
        @if (frame.Searchable && !Standalone)
        {
            <form class="masthead-search" role="search" method="get" action="@frame.Search" data-island="search">
                <svg class="masthead-search-icon" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="9" r="5.5"></circle><path d="M13 13l3.5 3.5"></path></svg>
                <input class="masthead-search-field" type="search" name="q" value="@frame.Searched" placeholder="Search" aria-label="Search this place" maxlength="200" autocomplete="off">
            </form>
        }
        <div class="masthead-actions">
            @if (frame.Who is { } who)
            {
                @if (who.Notifications is { } unseen)
                {
                    <a class="masthead-unseen" href="@unseen.Address" hidden="@(unseen.Count == 0)" aria-label="@Unseen(unseen.Count, unseen.AtLeast)"
                       data-island="unseen" data-props="@JsonSerializer.Serialize(new { reader = who.Id, count = unseen.Count, atLeast = unseen.AtLeast, through = unseen.Through, applications = unseen.Applications })">
                        <svg class="masthead-unseen-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)NotificationsIcon)</svg>
                        <span class="masthead-unseen-count">@unseen.Badge</span>
                    </a>
                }
                <details class="account">
                    <summary class="account-button" aria-label="@("Account, " + who.Name)">
                        @Mark(who)
                        <svg class="account-chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"></path></svg>
                    </summary>
                    <div class="account-panel">
                        <div class="account-who">
                            @Mark(who)
                            <span class="account-names">
                                <span class="account-name">@who.Name</span>
                                <span class="who-handle">@("@" + who.Handle + (who.Role is { } role ? " · " + role : ""))</span>
                            </span>
                        </div>
                        <div class="account-appearance appearance" data-island="appearance">
                            <span class="account-appearance-label" id="account-appearance-label">@Icon(AppearanceIcon)Appearance</span>
                            <div class="segmented" role="group" aria-labelledby="account-appearance-label">
                                <button type="button" data-theme-choice="system" aria-pressed="true">System</button>
                                <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
                                <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
                            </div>
                        </div>
                        <ul class="account-items">
                            @if (who.Notifications is { } notifications)
                            {
                                <li><a class="account-item" href="@notifications.Address">@Icon(NotificationsIcon)Notifications</a></li>
                            }
                            @if (who.Settings is { } settings)
                            {
                                <li><a class="account-item" href="@settings">@Icon(SettingsIcon)Settings</a></li>
                            }
                            <li><form method="post" action="@who.SignOut"><button class="account-item account-sign-out">@Icon(SignOutIcon)Sign out</button></form></li>
                        </ul>
                    </div>
                </details>
            }
            else if (frame.SignIn is { } signIn)
            {
                <a class="masthead-sign-in" href="@signIn">Sign in</a>
            }
        </div>
    </header>
    <nav class="path-bar" aria-label="You are here">
        <span class="path-elbow" aria-hidden="true"></span>
        <ol class="path-crumbs">
            @for (var index = 0; index < frame.Crumbs.Count; index++)
            {
                var crumb = frame.Crumbs[index];
                var last = index == frame.Crumbs.Count - 1;
                <li class="path-crumb">
                    @if (crumb.Switcher is { } switcher)
                    {
                        <details class="switcher">
                            <summary class="switcher-button" aria-current="@(last ? "page" : null)" aria-label="@(crumb.Label + ", switch Tangent")">
                                <TangentTile Tile="@switcher.Tile" />
                                <span class="switcher-label">@crumb.Label</span>
                                <svg class="switcher-chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"></path></svg>
                            </summary>
                            <div class="switcher-panel">
                                <p class="switcher-heading">Tangents</p>
                                <ul class="switcher-items">
                                    @foreach (var item in switcher.Tangents)
                                    {
                                        <li>
                                            <a class="switcher-item" href="@item.Address" aria-current="@(item.Current ? "page" : null)">
                                                <TangentTile Tile="@item.Tile" Size="menu" />
                                                <span class="switcher-item-text">
                                                    <span class="switcher-item-name">@item.Name</span>
                                                    <span class="switcher-item-detail">@item.Detail</span>
                                                </span>
                                                @if (item.Current)
                                                {
                                                    <span class="switcher-check">@Icon(CheckIcon)<span class="visually-hidden">Current</span></span>
                                                }
                                            </a>
                                        </li>
                                    }
                                </ul>
                                <a class="switcher-all" href="@switcher.All">@Icon(AllIcon)All Tangents</a>
                                @if (switcher.New is { } created)
                                {
                                    <a class="switcher-all" href="@created">@Icon(NewIcon)New Tangent</a>
                                }
                            </div>
                        </details>
                    }
                    else if (last)
                    {
                        <span aria-current="page" class="@(frame.Crumbs.Count == 1 ? "path-current path-only" : "path-current")">@crumb.Label</span>
                    }
                    else
                    {
                        <a href="@crumb.Address">@crumb.Label</a>
                        <span class="path-separator" aria-hidden="true">/</span>
                    }
                </li>
            }
        </ol>
    </nav>
    <CascadingValue Name="@nameof(Standalone)" Value="@Standalone" IsFixed="true">@ChildContent</CascadingValue>
    <footer class="footer">
        <Slot Name="footer" Html="@Slots.Footer" />
        <span class="footer-powered">Powered by Tangent Space</span>
        @if (!Standalone)
        {
            <div class="footer-end appearance" data-island="appearance">
                <span id="appearance-label">Appearance</span>
                <div class="segmented" role="group" aria-labelledby="appearance-label">
                    <button type="button" data-theme-choice="system" aria-pressed="true">System</button>
                    <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
                    <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
                </div>
            </div>
        }
    </footer>
}
else
{
    <CascadingValue Name="@nameof(Standalone)" Value="@Standalone" IsFixed="true">@ChildContent</CascadingValue>
}
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public string BaseUrl { get; set; } = "";

    [Parameter, EditorRequired] public string Accent { get; set; } = "";

    /// <summary>The place's own HTML, sanitized when it was written, so the same on the site, in an export and in the archive.</summary>
    [Parameter, EditorRequired] public Slots Slots { get; set; } = new();

    [Parameter] public Frame? Frame { get; set; }

    /// <summary>Whether the page opens with no server. The components inside it read the same, by this name.</summary>
    [Parameter] public bool Standalone { get; set; }

    /// <summary>The card's head block, already encoded (<see cref="Koan.Web.OpenGraph.IOpenGraphCardRenderer.RenderHead"/>).</summary>
    [Parameter] public string? Card { get; set; }

    /// <summary>The one line a page of the place's archive opens with.</summary>
    [Parameter] public string? Retired { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private const string AppearanceIcon = "<circle cx=\"10\" cy=\"10\" r=\"6.5\"></circle><path d=\"M10 3.5v13a6.5 6.5 0 0 0 0-13z\" fill=\"currentColor\" stroke=\"none\"></path>";
    private const string SettingsIcon = "<circle cx=\"10\" cy=\"10\" r=\"2.5\"></circle><path d=\"M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4\"></path>";
    private const string SignOutIcon = "<path d=\"M8 4.5H5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h3\"></path><path d=\"M12.5 6.5L16 10l-3.5 3.5\"></path><path d=\"M16 10H8\"></path>";
    private const string NotificationsIcon = "<path d=\"M5.5 13.5V9a4.5 4.5 0 0 1 9 0v4.5l1.5 1.5H4z\"></path><path d=\"M8.5 17a1.5 1.5 0 0 0 3 0\"></path>";
    private const string CheckIcon = "<path d=\"M5 10.5l3.2 3.2L15 7\"></path>";
    private const string NewIcon = "<path d=\"M10 4.5v11M4.5 10h11\"></path>";
    private const string AllIcon = "<rect x=\"3.5\" y=\"3.5\" width=\"5\" height=\"5\" rx=\"1\"></rect><rect x=\"11.5\" y=\"3.5\" width=\"5\" height=\"5\" rx=\"1\"></rect><rect x=\"3.5\" y=\"11.5\" width=\"5\" height=\"5\" rx=\"1\"></rect><rect x=\"11.5\" y=\"11.5\" width=\"5\" height=\"5\" rx=\"1\"></rect>";

    /// <summary>How many notifications the reader has not seen, in words: "at least" where the count is a lower bound.</summary>
    public static string Unseen(int count, bool atLeast)
        => (atLeast ? "At least " : "") + count.ToString(CultureInfo.InvariantCulture) + (count == 1 && !atLeast ? " new notification" : " new notifications");

    /// <summary>A menu item's 16px icon, drawn in the text's colour and hidden from assistive technology.</summary>
    private static RenderFragment Icon(string paths) => builder => builder.AddMarkupContent(0,
        "<svg class=\"menu-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">" + paths + "</svg>");

    /// <summary>A participant's mark in the masthead: their avatar, or two letters of their handle on their own tint.</summary>
    private static RenderFragment Mark(Who who) => builder =>
    {
        if (Monogram.Avatar(who.Avatar) is { } avatar)
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "class", "who-mark");
            builder.AddAttribute(2, "src", avatar);
            builder.AddAttribute(3, "alt", "");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "class", "who-mark tone-" + Monogram.Tone(who.Id));
        builder.AddAttribute(6, "aria-hidden", "true");
        builder.AddContent(7, Monogram.Letters(who.Handle));
        builder.CloseElement();
    };
}
