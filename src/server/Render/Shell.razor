@using System.Globalization
@using System.Text.Json
@using Tangent.Space
@* The page around one resource's component: the accent Tangent's palette wears, and any base other than Tangent's own, on
   <html>; the order of the five layers, stated once, then the stylesheets of the place's appearance in them — Tangent's components, then its base, whose arrangement, where it
   has one, follows Tangent's own in the tangent layer, then its palette, and the place's own CSS as the owner layer, which
   a management page leaves out — and the two scripts every page loads, absolute from the base URL. The theme script blocks in <head> so the reader's theme applies before the first paint; the
   page script is a module, deferred by nature, that mounts the islands once the document is parsed. A standalone page
   opens with no server and no script: the device decides its theme, and no island answers on it. A resource
   that names a frame is drawn inside it: the masthead with the place's mark and name, the search box, a form that works without JavaScript and suggests as someone types with it, and, for someone signed in, how
   many things are for them and new, shown only while there are some, which the page's stream raises as new ones
   arrive, a link to the door where they are read, and their account opening in the page with their name, handle and
   role, the place's settings for whoever may change them, and the way to sign out, or for a visitor the way to
   sign in; the path bar whose elbow hangs from the mark, with a Tangent's crumb opening the list of Tangents
   in the page, and where a new one is created for whoever may; and the footer with the theme a visitor can choose. A page a visitor may
   read carries in its head the card a link to it previews, and every page the place's image as its icon. A page of the place's archive opens with the one line that says it is retired. The place's
   words come through here, Markdown drawn as a Post's body is: its masthead line after the place's name and its footer line first in the footer, each adding nothing while it is empty.
   Every framed page carries the person island, which opens a participant's card beside any name, mark or mention of
   them. Nothing here is a dialog. *@
<!DOCTYPE html>
<html lang="en" data-accent="@Appearance.Accent" data-base="@Appearance.BaseAttribute">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title</title>
    <link rel="stylesheet" href="@(BaseUrl + "/" + HtmlFormatter.Layers)">
    <link rel="stylesheet" href="@(BaseUrl + "/" + HtmlFormatter.Stylesheet)">
    <link rel="stylesheet" href="@(BaseUrl + "/" + Appearance.BaseSheet)">
    <link rel="stylesheet" href="@(BaseUrl + "/" + Appearance.PaletteSheet)">
    @if (!Management && Appearance.CssLayer is { } owner)
    {
        <style>@((MarkupString)owner)</style>
    }
    @if (!Standalone)
    {
        <script src="@(BaseUrl)/theme.js"></script>
        <script type="module" src="@(BaseUrl)/tangent.js"></script>
    }
    @if (!Standalone && Retired is null)
    {
        <link rel="@LlmsText.Relation" href="@LlmsText.Address(BaseUrl)">
    }
    @foreach (var feed in Frame?.Feeds ?? [])
    {
        <link rel="alternate" type="@feed.Type" title="@feed.Title" href="@feed.Address">
    }
    @if (Frame?.Document is { } document)
    {
        <link rel="site.standard.document" href="@document">
    }
    @if (Card is not null)
    {
        @((MarkupString)Card)
    }
    @if (Appearance.ImageAt(BaseUrl + "/", Images) is { } icon)
    {
        <link rel="icon" href="@icon">
    }
</head>
<body>
@if (Retired is { } retired)
{
    <p class="retired-line">@retired</p>
}
@if (Frame is { } frame)
{
    <CascadingValue Name="@Page.ReaderValue" Value="@frame.Who?.Id" IsFixed="true">
    <header class="masthead bar place">
        <a class="masthead-place chip place" href="@frame.Door">
            <span class="masthead-mark" aria-hidden="true">@frame.Initial</span>
            <span class="masthead-name">@frame.Place</span>
        </a>
        @if (PlaceWords.Html(Appearance.MastheadPart, Appearance.Masthead, Images) is { } masthead)
        {
            <div class="masthead-line">@((MarkupString)masthead)</div>
        }
        @if (!Standalone)
        {
            <Draw Part="@frame.Searching" As="Shape.Inline" />
        }
        <div class="masthead-actions">
            @if (frame.Who is { } who)
            {
                @if (who.ForYou is { } forYou)
                {
                    <a class="masthead-unseen" href="@forYou.Door" hidden="@(forYou.Count == 0)" aria-label="@forYou.Words"
                       data-island="unseen" data-props="@JsonSerializer.Serialize(new { reader = who.Id, count = forYou.Count, atLeast = forYou.AtLeast, through = forYou.Through, applications = forYou.Applications })">
                        <svg class="masthead-unseen-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)ForYouIcon)</svg>
                        <span class="masthead-unseen-count">@forYou.Shown</span>
                    </a>
                }
                <details class="account menu participant is-you">
                    <summary class="account-button" aria-label="@("Account, " + who.Name)">
                        <Draw Part="@who.Person" />
                        <svg class="account-chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"></path></svg>
                    </summary>
                    <div class="account-panel panel">
                        <div class="account-who">
                            <Draw Part="@who.Person" As="Shape.Row" />
                        </div>
                        <div class="account-appearance appearance" data-island="appearance">
                            <span class="account-appearance-label" id="account-appearance-label"><Draw Part="@(new Render.Icon("theme"))" />Theme</span>
                            <div class="segmented" role="group" aria-labelledby="account-appearance-label">
                                <button type="button" data-theme-choice="system" aria-pressed="true">System</button>
                                <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
                                <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
                            </div>
                        </div>
                        <ul class="account-items list">
                            @if (who.Settings is { } settings)
                            {
                                <li><a class="account-item" href="@settings"><Draw Part="@(new Render.Icon("settings"))" />Settings</a></li>
                            }
                            <li><a class="account-item" href="@(frame.Door.TrimEnd('/') + Participants.BringYourAgentController.Path)"><Draw Part="@(new Render.Icon("agent"))" />Bring your agent</a></li>
                            <li><a class="account-item" href="@(frame.Door.TrimEnd('/') + Connections.ConnectionsController.Path)"><Draw Part="@(new Render.Icon("connections"))" />Connections</a></li>
                            <li>
                                <Draw Part="@who.Another" As="Shape.Menu" />
                            </li>
                            <li><Draw Part="@who.Leaving" As="Shape.Menu" /></li>
                        </ul>
                    </div>
                </details>
            }
            else if (frame.SignIn is { } signIn)
            {
                <a class="masthead-sign-in" href="@signIn">Sign in</a>
            }
        </div>
    </header>
    </CascadingValue>
    @if (frame.Crumbs.Count > 0)
    {
    <nav class="path" aria-label="You are here">
        <span class="path-elbow" aria-hidden="true"></span>
        <ol class="path-crumbs">
            @for (var index = 0; index < frame.Crumbs.Count; index++)
            {
                var crumb = frame.Crumbs[index];
                var last = index == frame.Crumbs.Count - 1;
                <li class="path-crumb">
                    @if (crumb.Switcher is { } switcher)
                    {
                        <details class="switcher menu tangent">
                            <summary class="switcher-button" aria-current="@(last ? "page" : null)" aria-label="@(crumb.Label + ", switch Tangent")">
                                <Draw Part="@switcher.Current" As="Shape.Tile" />
                                <span class="switcher-label">@crumb.Label</span>
                                <svg class="switcher-chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"></path></svg>
                            </summary>
                            <div class="switcher-panel panel">
                                <p class="switcher-heading">Tangents</p>
                                <ul class="switcher-items list">
                                    @foreach (var item in switcher.Tangents)
                                    {
                                        <li><Draw Part="@item" /></li>
                                    }
                                </ul>
                                <a class="switcher-all" href="@switcher.All"><Draw Part="@(new Render.Icon("all"))" />All Tangents</a>
                                @if (switcher.New is { } created)
                                {
                                    <a class="switcher-all" href="@created"><Draw Part="@(new Render.Icon("new"))" />New Tangent</a>
                                }
                            </div>
                        </details>
                    }
                    else if (last)
                    {
                        <span aria-current="page" class="@(frame.Crumbs.Count == 1 ? "path-current path-only is-current" : "path-current is-current")">@crumb.Label</span>
                    }
                    else
                    {
                        <a href="@crumb.Address">@crumb.Label</a>
                        <span class="path-separator" aria-hidden="true">/</span>
                    }
                </li>
            }
        </ol>
    </nav>
    }
    <CascadingValue Name="@nameof(Standalone)" Value="@Standalone" IsFixed="true">@ChildContent</CascadingValue>
    <footer class="footer bar">
        @if (PlaceWords.Html(Appearance.FooterPart, Appearance.Footer, Images) is { } footer)
        {
            <div class="footer-line">@((MarkupString)footer)</div>
        }
        <span class="footer-powered">Powered by Tangent Space</span>
        @if (!Standalone)
        {
            <div class="footer-end appearance" data-island="appearance">
                <span id="appearance-label">Theme</span>
                <div class="segmented" role="group" aria-labelledby="appearance-label">
                    <button type="button" data-theme-choice="system" aria-pressed="true">System</button>
                    <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
                    <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
                </div>
            </div>
        }
    </footer>
    @if (!Standalone)
    {
        <div hidden data-island="person" data-props="@JsonSerializer.Serialize(new { door = BaseUrl + "/" })"></div>
    }
}
else
{
    <CascadingValue Name="@nameof(Standalone)" Value="@Standalone" IsFixed="true">@ChildContent</CascadingValue>
}
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public string BaseUrl { get; set; } = "";

    /// <summary>How the place looks: the stylesheet of each of its layers, its accent, its own CSS, its image and its words.</summary>
    [Parameter, EditorRequired] public Appearance Appearance { get; set; } = new();

    /// <summary>Whether the page is one of the place's management pages, which leave out the owner layer, so no stylesheet
    /// of the place's can hide the way back.</summary>
    [Parameter] public bool Management { get; set; }

    [Parameter] public Frame? Frame { get; set; }

    /// <summary>Where the images of the place's words are named, ending in a slash: under the base URL, or under the place's
    /// own address on a standalone page, whose writer carries each beside it.</summary>
    [Parameter] public string? MediaBase { get; set; }

    private string Images => MediaBase ?? BaseUrl + "/";

    /// <summary>Whether the page opens with no server. The components inside it read the same, by this name.</summary>
    [Parameter] public bool Standalone { get; set; }

    /// <summary>The card's head block, already encoded (<see cref="Koan.Web.OpenGraph.IOpenGraphCardRenderer.RenderHead"/>).</summary>
    [Parameter] public string? Card { get; set; }

    /// <summary>The one line a page of the place's archive opens with.</summary>
    [Parameter] public string? Retired { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private const string ForYouIcon = "<path d=\"M5.5 13.5V9a4.5 4.5 0 0 1 9 0v4.5l1.5 1.5H4z\"></path><path d=\"M8.5 17a1.5 1.5 0 0 0 3 0\"></path>";
}
