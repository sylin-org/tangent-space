@* A panel's head: one dark band, the place's face, with the mark and the name at its bottom left. A place with no
   landing image of its own shows its atmosphere across the whole band, the field of characters drawn in its
   accent, never a picture it did not choose; a shade deepens the band under the mark and the name. *@
<div class="panel-head">
    <pre class="panel-head-atmosphere" aria-hidden="true">@Atmosphere</pre>
    <span class="panel-head-shade" aria-hidden="true"></span>
    <span class="panel-head-mark" aria-hidden="true">@Frame.Initial</span>
    <span class="panel-head-name">@Frame.Place</span>
</div>

@code {
    [Parameter, EditorRequired] public Frame Frame { get; set; } = default!;

    /// <summary>The atmosphere a place has before it chooses one: the design reference's first, a lantern's glow.</summary>
    private const string Atmosphere =
        "       . .....               ...,,,,,,,,,,,,,,,,,,,,,,.,.....\n" +
        "     . .........            ..,,,,,:::::,,,,,,,,,,,,,,,,,........\n" +
        "      ...........         ..,,:::::::::,,,,.........,.,,.,,,,......\n" +
        "     ...........           .,,:++++*+++:,,..          ....,.,........\n" +
        "       ...........         ..,:+*#####***+:,..         . ....,.,.....\n" +
        "       ..........           .,:+*##########*+:,.           .........\n" +
        "      ......,.,......         .,::+**######*+:,,.           ..........\n" +
        "        ....,,..,,....          .,,,:+++++++::,...           ..........\n" +
        "         ........,,.,.............,,,::::+:::,,.            .........  .\n" +
        "           ......,,,,,,,,,,,,,,,,,::::::::,,,,..            .........";
}
