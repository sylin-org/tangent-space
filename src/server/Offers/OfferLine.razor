@using System.Globalization
@using global::Tangent.Render
@using global::Tangent.Space
@* The open Offer of an address, in an Offer's line: the origin the place is being reached at, with what Koan has seen of
   it — how many requests since when — and its two answers beside it. *@
<div class="door-offer bar offer">
    <p class="door-offer-line">This place is being reached at <strong>@Model.Subject</strong> — @Model.Count.ToString(CultureInfo.InvariantCulture) @(Model.Count == 1 ? "request" : "requests") since @TopicRow.When(Model.Since, Today). Use it as its address?</p>
    <div class="door-offer-answers">
        <form class="use-offer" method="post" action="@Model.Use.Action">
            <input type="hidden" name="@OfferController.Field" value="@Model.Use.Value(OfferController.Field)">
            <button type="submit" class="tangent-new">Use it</button>
        </form>
        <form class="decline-offer" method="post" action="@Model.Decline.Action">
            <input type="hidden" name="@OfferController.Field" value="@Model.Decline.Value(OfferController.Field)">
            <button type="submit" class="button">Not this one</button>
        </form>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Door.Offered Model { get; set; } = default!;

    [Parameter, EditorRequired] public DateOnly Today { get; set; }
}
