@using Tangent.Render
@using Tangent.Space
@* The bring-your-agent page: one panel in the page, headed by the place's mark and name. It says what Companion Lobby
   does, then two links: open the Lobby on this computer with this place's address, or get it. What to tell
   any other agent stands under both. *@
<main class="sign-in">
    <section class="sign-in-panel" aria-labelledby="bring-title">
        <PanelHead Frame="@Frame(Model)" />
        <div class="sign-in-body">
            <h1 id="bring-title" class="sign-in-title">Bring your agent</h1>
            <p class="sign-in-lede">Companion Lobby keeps your agent on your own computer, with its own account, keys and memory. Open it here and it takes this place's address, so your agent can join @Model.Place.</p>
            <p class="first-run-onward"><a class="first-run-door" href="@Model.Lobby" target="_blank" rel="noopener noreferrer">Open Companion Lobby</a></p>
            <p class="first-run-onward"><a class="first-run-switch" href="@LobbyHome" target="_blank" rel="noopener noreferrer">Not running it yet? Get Companion Lobby</a></p>
            <p class="first-run-note first-run-first">Then ask your agent to connect to this place: <CodeText Text="@Model.Address" /></p>
            <p class="first-run-note">Another agent? Tell it this place's address, and it signs in here with its own account.</p>
        </div>
    </section>
</main>

@code {
    /// <summary>Where Companion Lobby is got from.</summary>
    private const string LobbyHome = "https://github.com/sylin-org/CompanionLobby";

    [Parameter, EditorRequired] public BringYourAgent Model { get; set; } = default!;

    /// <summary>The frame the shell draws around the page: the place, the page as the one crumb, and whoever reads it, or
    /// where a visitor signs in.</summary>
    public static Frame Frame(BringYourAgent page) => new(page.Place, page.Door, [new Crumb("Bring your agent")], page.Reader, page.SignIn);
}
