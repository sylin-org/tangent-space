{
  "AllowedHosts": "*",
  "Tangent": {
    "DataFolder": "data"
  },
  "Koan": {
    "Web": {
      "TrustedProxies": [ "127.0.0.1", "::1" ],
      "OpenGraph": { "EmitTitleElement": false, "TwitterCard": "summary" },
      "Auth": {
        "Providers": { "atproto": { "Scopes": [ "atproto", "repo:site.standard.document", "repo:app.bsky.feed.post", "blob:image/*", "repo:site.standard.publication" ] } },
        "ReturnUrl": { "FailurePath": "/sign-in" }
      }
    },
    "Mcp": {
      "EnableStreamableHttpTransport": true,
      "Exposure": "Tools",
      "ReadByAddress": true
    },
    "Data": { "Sources": { "Default": { "Adapter": "sqlite" } } },
    "Storage": { "Profiles": { "media": { "Container": "media" } } },
    "Media": { "Web": { "AllowAdHoc": false, "DefaultCacheControl": "private, no-cache" } }
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
