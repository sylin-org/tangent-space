@using Tangent.Render
@* First run: one panel in the page, headed by the place's mark and name. Before sign-in it holds the handle form, the
   field focused, and says who may set the place up where the configuration names someone; signed in as someone who
   may, the one action that sets it up under the name it will take; signed in as anyone else, who may and the way to
   another account; once established, the pointers the site places, each ready to copy. Every hint is one sentence; a
   refusal shows above the action. *@
<main class="sign-in first-run">
    <section class="@PanelClass" aria-labelledby="first-run-title">
        <PanelHead Frame="@Frame(Model)" />
        <div class="sign-in-body">
        @if (Model.Pointers is { } pointers)
        {
            <h1 id="first-run-title" class="sign-in-title">@Model.Name is ready</h1>
            <p class="sign-in-lede">It answers at <a href="@Model.Door"><CodeText Text="@(Model.BaseUrl ?? "")" /></a>; place any one of these on your site.</p>
            <ol class="first-run-pointers">
                @for (var index = 0; index < pointers.Count; index++)
                {
                    var pointer = pointers[index];
                    var id = "pointer-" + pointer.Kind;
                    <li class="first-run-pointer" data-pointer="@pointer.Kind">
                        <div class="first-run-pointer-head">
                            <h2 class="first-run-pointer-title" id="@(id)-title">@Title(pointer)</h2>
                            @if (pointer.Text.Length > 0)
                            {
                                <button type="button" class="first-run-copy" data-island="copy" data-props="@("{\"target\":\"" + id + "\"}")"
                                        aria-describedby="@(id)-title" hidden>Copy</button>
                            }
                        </div>
                        <p class="first-run-pointer-where"><CodedSentence Text="@pointer.Where" /></p>
                        @if (pointer.Text.Length > 0)
                        {
                            <pre class="first-run-snippet" id="@id" tabindex="0"><code>@pointer.Text</code></pre>
                        }
                    </li>
                }
            </ol>
            <p class="first-run-onward">
                <a class="first-run-door" href="@Model.Door">Open @Model.Name</a>
            </p>
        }
        else if (Model.SetUp is { } setUp)
        {
            <h1 id="first-run-title" class="sign-in-title">Set up this Tangent Space</h1>
            <p class="sign-in-lede">
                @if (setUp.Handle.Length > 0)
                {
                    <text>You’re signed in as <strong>@("@" + setUp.Handle)</strong>, and setting it up makes the place yours, with every permission here.</text>
                }
                else
                {
                    <text>You’re signed in, and setting it up makes the place yours, with every permission here.</text>
                }
            </p>
            @if (setUp.Failure is { } failure)
            {
                <p class="sign-in-failure" id="first-run-failure" role="alert">@failure</p>
            }
            <form class="sign-in-form" method="post" action="@setUp.Action" data-island="submitting">
                <FormTokenField Token="@setUp.Token" />
                <button type="submit" class="sign-in-submit" data-busy-label="Setting up…">Set up @setUp.Name</button>
            </form>
        }
        else if (Model.Waiting is { } waiting)
        {
            <h1 id="first-run-title" class="sign-in-title">Waiting for its operator</h1>
            <p class="sign-in-lede">
                @if (waiting.Handle.Length > 0)
                {
                    <text>You’re signed in as <strong>@("@" + waiting.Handle)</strong>, and this place is still being set up: check back soon.</text>
                }
                else
                {
                    <text>You’re signed in, and this place is still being set up: check back soon.</text>
                }
            </p>
            <p class="first-run-rule">
                Only
                @if (waiting.OperatorHandle is { } operatorHandle && NamedByDid)
                {
                    <strong>@("@" + operatorHandle)</strong> <span class="first-run-did">(<CodeText Text="@(Model.Operator ?? "")" />)</span>
                }
                else if (waiting.OperatorHandle is { } configuredHandle)
                {
                    <strong>@("@" + configuredHandle)</strong>
                }
                else
                {
                    <CodeText Text="@(Model.Operator ?? "")" />
                }
                can set it up.
            </p>
            <p class="first-run-note first-run-first">If that is you, sign in with that account.</p>
            @if (Model.Reader is { } reader)
            {
                <p class="first-run-onward">
                    <a class="first-run-switch" href="@reader.SignOut">Use another account</a>
                </p>
            }
        }
        else
        {
            <h1 id="first-run-title" class="sign-in-title">Set up this Tangent Space</h1>
            <p class="sign-in-lede">Sign in with the account that will run it, and setting it up takes one step.</p>
            <form class="sign-in-form" method="get" action="@Model.ChallengeAddress()" data-island="submitting">
                <div class="field">
                    <label class="field-label" for="first-run-sign-in-handle">Handle</label>
                    <span class="field-input">
                        <span class="field-prefix" aria-hidden="true">@@</span>
                        <input id="first-run-sign-in-handle" name="identifier" type="text" required autofocus
                               autocomplete="username" autocapitalize="none" spellcheck="false"
                               placeholder="yourname.bsky.social">
                    </span>
                </div>
                <input type="hidden" name="return" value="@Model.ChallengeReturn()">
                <button type="submit" class="sign-in-submit" data-busy-label="Continuing…">Continue</button>
            </form>
            @if (Model.Operator is { } named)
            {
                <p class="first-run-note first-run-first">
                    Only
                    @if (NamedByDid)
                    {
                        <CodeText Text="@named" />
                    }
                    else
                    {
                        <strong>@("@" + named)</strong>
                    }
                    can set it up.
                </p>
            }
        }
        </div>
    </section>
</main>

@code {
    [Parameter, EditorRequired] public FirstRun Model { get; set; } = default!;

    /// <summary>The frame the shell draws around the page: the place, the step as the one crumb, and the account of
    /// whoever is signed in.</summary>
    public static Frame Frame(FirstRun firstRun)
        => new(firstRun.Name, firstRun.Door, [new Crumb(firstRun.Pointers is null ? "First run" : "Pointers")],
            firstRun.Reader is { } reader ? new Who(reader.Id, reader.Name, reader.Handle, reader.Role, reader.Avatar, reader.SignOut) : null);

    private string PanelClass => Model.Pointers is null ? "sign-in-panel" : "sign-in-panel first-run-panel";

    /// <summary>Whether the configuration names the account that may set the place up by its DID.</summary>
    private bool NamedByDid => Model.Operator?.StartsWith("did:", StringComparison.Ordinal) == true;

    private static string Title(Pointer pointer) => pointer.Kind switch
    {
        Pointers.Link => "A link on your site’s pages",
        Pointers.WellKnown => "A file at your site’s origin",
        Pointers.Txt => "A DNS record",
        Pointers.Proxy => "The reverse-proxy rule for the path",
        _ => pointer.Kind
    };
}
