@using global::Tangent.Posts
@using global::Tangent.Render
@* The place's settings, admission: the sections of the settings in the rail, this one marked, and in one panel beside
   them the choice of how a newcomer arrives, two cards, each saying in a sentence what it means for them, and a note that
   everyone already here stays as they are. A reader who may not change it reads why above the form, whose choices are
   disabled and which has no button, and a visitor the way to sign in; a refusal shows above the form. *@
<div class="layout layout-settings">
    <SettingsRail Sections="@Model.Sections" />
    <main>
        <section class="sign-in-panel post-form-panel" aria-labelledby="space-admission-heading">
            <div class="sign-in-body">
                <p class="post-form-where">Settings of <a href="@Model.Door">@Model.Place</a></p>
                <h1 id="space-admission-heading" class="sign-in-title">@TangentSpaceSettingsController.AdmissionSection</h1>
                @if (Model.Gate is { } gate)
                {
                    <p class="sign-in-failure" id="space-admission-failure" role="alert" data-gate="@gate">
                        @if (Model.SignIn is { } signIn)
                        {
                            @(PostWrites.Sentence(gate) + " ")<a href="@signIn">Sign in</a>
                        }
                        else
                        {
                            @PostWrites.Sentence(gate)
                        }
                    </p>
                }
                else if (Model.Failure is { } failure)
                {
                    <p class="sign-in-failure" id="space-admission-failure" role="alert">@failure</p>
                }
                <form class="sign-in-form" method="post" action="@Model.Action" data-island="@(Mutable ? "submitting" : null)">
                    <FormTokenField Token="@Model.Token" />
                    <fieldset class="post-form-choice">
                        <legend class="field-label">How a newcomer arrives</legend>
                        <div class="post-form-options">
                            @foreach (var word in Model.Admissions)
                            {
                                <label class="post-form-option">
                                    <span class="post-form-option-text">
                                        <span class="post-form-option-name">@Name(word)</span>
                                        <span class="post-form-option-detail">@Detail(word)</span>
                                    </span>
                                    <input type="radio" name="@TangentSpaceSettingsController.AdmissionField" value="@word"
                                           checked="@(word == Model.Admission)" disabled="@(!Mutable)">
                                </label>
                            }
                        </div>
                    </fieldset>
                    <p class="post-form-note">Everyone already here stays as they are.</p>
                    @if (Mutable)
                    {
                        <div class="post-form-actions">
                            <a class="post-form-cancel" href="@Model.Door">Back to the door</a>
                            <button type="submit" class="sign-in-submit post-form-submit" data-busy-label="Saving…">Save</button>
                        </div>
                    }
                </form>
            </div>
        </section>
    </main>
</div>

@code {
    [Parameter, EditorRequired] public AdmissionSettingsPage Model { get; set; } = default!;

    /// <summary>Whether the reader may change the admission here.</summary>
    private bool Mutable => Model.Gate is null;

    private static string Name(string word) => word == TangentSpaceSettingsController.Word(Admission.Apply) ? "Apply and wait" : "Join at once";

    private static string Detail(string word) => word == TangentSpaceSettingsController.Word(Admission.Apply)
        ? "Whoever signs in applies, reads what a visitor may, and takes part once someone admits them."
        : "Whoever signs in takes part at once: they start topics and reply.";

    /// <summary>The frame the shell draws around the page: the place and its settings as crumbs, and who reads, or where
    /// a visitor signs in.</summary>
    public static Frame Frame(AdmissionSettingsPage page)
        => new(page.Place, page.Door, [new Crumb(page.Place, page.Door), new Crumb("Settings")], page.Who, page.SignIn);
}
