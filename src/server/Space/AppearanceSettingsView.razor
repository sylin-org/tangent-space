@using System.Globalization
@using System.Text.Json
@using global::Tangent.Render
@* The place's settings, appearance: the sections of the settings in the rail, this one marked, and in one panel beside
   them, top to bottom, what makes the place its proprietor's — the door as it will look, drawn in the choices before they
   are saved, following each change where script runs and on Preview where it does not; the place's image, none, one of
   the covers Tangent bundles, each a card with its picture, or one of their own, taken at once; the place's words in
   Markdown, its description and its welcome; its colours, five cards, the base's own and Tangent's four accents, each
   with its swatch; its base, Tangent's own or a bundled stylesheet, each a card; and behind one quiet disclosure, open
   once any holds something, the masthead and footer lines, the article header and the place's own CSS. A part away from
   its default returns there in one press of its own. A reader who may not change them reads why above the form, whose
   choices are disabled, whose fields are read-only and which has no button, and a visitor the way to sign in; a refusal
   shows above the form. *@
<main class="layout layout-settings">
    <SettingsRail Sections="@Model.Sections" />
    <div class="layout-main">
        <section class="sign-in-panel post-form-panel panel place" aria-labelledby="space-appearance-heading">
            <div class="sign-in-body">
                <p class="post-form-where">Settings of <a href="@Model.Door">@Model.Place</a></p>
                <h1 id="space-appearance-heading" class="sign-in-title">@TangentSpaceSettingsController.AppearanceSection</h1>
                @if (Model.Gate is { } gate)
                {
                    <p class="sign-in-failure" id="space-appearance-failure" role="alert" data-gate="@gate">
                        @if (Model.SignIn is { } signIn)
                        {
                            @(Access.Capabilities.Sentence(gate) + " ")<a href="@signIn">Sign in</a>
                        }
                        else
                        {
                            @Access.Capabilities.Sentence(gate)
                        }
                    </p>
                }
                else if (Model.Failure is { } failure)
                {
                    <p class="sign-in-failure" id="space-appearance-failure" role="alert">@failure</p>
                }
                <form class="sign-in-form change-appearance" method="post" action="@Model.Change?.Action" data-island="@(Mutable ? "submitting" : null)">
                    @if (Model.Preview is { } preview)
                    {
                        <div class="field appearance-preview-field">
                            <span class="field-label">Your door, as it will look</span>
                            <iframe class="appearance-preview" name="appearance-preview" src="@preview" title="Your door, as it will look"
                                    data-island="preview" data-props="@JsonSerializer.Serialize(new { button = "appearance-preview-button" })"></iframe>
                            <button type="submit" class="button" id="appearance-preview-button" formaction="@preview" formtarget="appearance-preview">Preview</button>
                        </div>
                    }
                    <fieldset class="post-form-choice appearance-image">
                        <legend class="field-label">The place's image</legend>
                        <div class="cover-choices">
                            <label class="cover-choice is-none">
                                <input type="radio" name="@TangentSpaceSettingsController.ImageField" value="" checked="@(Model.Image.Length == 0)" disabled="@(!Mutable)">
                                <span class="cover-picture" aria-hidden="true"></span>
                                <span class="cover-name">None</span>
                            </label>
                            @if (Own is { } own)
                            {
                                <label class="cover-choice">
                                    <input type="radio" name="@TangentSpaceSettingsController.ImageField" value="@Model.Image" checked disabled="@(!Mutable)">
                                    <img class="cover-picture" src="@own" alt="" loading="lazy">
                                    <span class="cover-name">Your own</span>
                                </label>
                            }
                            @foreach (var cover in Model.Covers)
                            {
                                <label class="cover-choice">
                                    <input type="radio" name="@TangentSpaceSettingsController.ImageField" value="@cover.Name" checked="@(cover.Name == Model.Image)" disabled="@(!Mutable)">
                                    <img class="cover-picture" src="@cover.Address" alt="" loading="lazy">
                                    <span class="cover-name">@cover.Title</span>
                                </label>
                            }
                        </div>
                        @if (Model.Upload is not null)
                        {
                            <div class="cover-upload">
                                <label class="field-label" for="space-appearance-file">Or bring your own</label>
                                <input id="space-appearance-file" type="file" name="@TangentSpaceSettingsController.FileField" form="appearance-image-form"
                                       accept="image/png,image/jpeg,image/webp" required>
                                <button type="submit" class="button" form="appearance-image-form" data-busy-label="Bringing it in…">Use this image</button>
                                <p class="post-form-note">A PNG, JPEG or WebP. The place wears it at once, behind the door's head and as every page's icon; anyone who reads the door sees it.</p>
                            </div>
                        }
                    </fieldset>
                    @Words(TangentSpaceSettingsController.DescriptionField, "Description", Model.Description, 2, TangentSpace.DescriptionLimit,
                        "Under the place's name on the door. Its words are what a link to the door says of it.")
                    @Words(TangentSpaceSettingsController.IntroField, "Welcome", Model.Intro, 5, Appearance.ProseLimit,
                        "Under the door's head, for whoever the place exists for: what this place is for and how to begin.")
                    <fieldset class="post-form-choice">
                        <legend class="field-label">The colours</legend>
                        <div class="post-form-options">
                            @foreach (var word in Model.Palettes)
                            {
                                <label class="post-form-option">
                                    @if (Swatch(word) is { } swatch)
                                    {
                                        <span class="accent-swatch" data-swatch="@swatch" aria-hidden="true"></span>
                                    }
                                    <span class="post-form-option-text">
                                        <span class="post-form-option-name">@PaletteName(word)</span>
                                        <span class="post-form-option-detail">@PaletteDetail(word)</span>
                                    </span>
                                    <input type="radio" name="@TangentSpaceSettingsController.PaletteField" value="@word"
                                           checked="@(word == Model.Palette)" disabled="@(!Mutable)">
                                </label>
                            }
                        </div>
                    </fieldset>
                    <p class="post-form-note">Links, buttons and what is new take the accent on every page, for everyone. Light or dark is each reader's own, at the foot of any page.</p>
                    @Reset("appearance-reset-palette", Model.Palette != Appearance.Word(Space.Palette.Base), "Return to the base's own colours")
                    <fieldset class="post-form-choice">
                        <legend class="field-label">The base: the plain elements and the fonts</legend>
                        <div class="post-form-options">
                            @foreach (var word in Model.Bases)
                            {
                                <label class="post-form-option">
                                    <span class="post-form-option-text">
                                        <span class="post-form-option-name">@BaseName(word)</span>
                                        <span class="post-form-option-detail">@BaseDetail(word)</span>
                                    </span>
                                    <input type="radio" name="@TangentSpaceSettingsController.BaseField" value="@word"
                                           checked="@(word == Model.Base)" disabled="@(!Mutable)">
                                </label>
                            }
                        </div>
                    </fieldset>
                    @Reset("appearance-reset-base", Model.Base != Appearance.Word(Space.Base.Tangent), "Return to Tangent's own base")
                    <details class="post-form-more" open="@(Model.Masthead.Length + Model.Footer.Length + Model.ArticleHeader.Length + Model.Css.Length > 0)">
                        <summary class="sign-in-other-toggle">Lines, the article header and your own CSS</summary>
                        <div class="post-form-more-body">
                            @Words(TangentSpaceSettingsController.MastheadField, "Masthead line", Model.Masthead, 2, Appearance.LineLimit,
                                "Beside the place's name on every page.")
                            @Words(TangentSpaceSettingsController.FooterField, "Footer line", Model.Footer, 2, Appearance.LineLimit,
                                "First in every page's footer.")
                            @Words(TangentSpaceSettingsController.ArticleHeaderField, "Article header", Model.ArticleHeader, 3, Appearance.ProseLimit,
                                "Above every article's title.")
                            <p class="post-form-note">Each is Markdown, written as a Post is. An image comes from another site or from under /media/ here. The pages of an export and of the archive carry them.</p>
                            <div class="field">
                                <label class="field-label" for="space-appearance-css">Your own CSS</label>
                                <textarea class="post-form-body slot-source appearance-css" id="space-appearance-css" name="@TangentSpaceSettingsController.CssField" rows="8"
                                          spellcheck="false" maxlength="@Appearance.CssLimit" readonly="@(!Mutable)" aria-describedby="space-appearance-css-note">@Model.Css</textarea>
                                <p class="post-form-note" id="space-appearance-css-note">Over every other layer, on every page but these settings. Pages say what each thing is: <code>article.post.by-agent &gt; header</code>, <code>.row.topic.is-new</code>, <code>.tangent-head.is-pictured</code>. At most @Appearance.CssLimit.ToString("N0", CultureInfo.InvariantCulture) characters.</p>
                            </div>
                            @if (Mutable && Model.Css.Length > 0)
                            {
                                <details class="post-form-more appearance-clear">
                                    <summary class="sign-in-other-toggle">Clear your CSS</summary>
                                    <div class="post-form-more-body">
                                        <p class="post-form-note">Your CSS goes, and every page wears the other layers alone.</p>
                                        <button type="submit" class="button" form="appearance-reset-css">Clear it</button>
                                    </div>
                                </details>
                            }
                        </div>
                    </details>
                    @if (Mutable)
                    {
                        <div class="post-form-actions">
                            <a class="post-form-cancel" href="@Model.Door">Back to the door</a>
                            <button type="submit" class="sign-in-submit post-form-submit" data-busy-label="Saving…">Save</button>
                        </div>
                    }
                </form>
                @if (Model.Upload is { } upload)
                {
                    <form id="appearance-image-form" class="change-appearance" method="post" action="@upload" enctype="multipart/form-data" hidden></form>
                }
                @if (Model.Change is { } change)
                {
                    @ResetForm("appearance-reset-base", change.Action, TangentSpaceSettingsController.BaseField, Appearance.Word(Space.Base.Tangent))
                    @ResetForm("appearance-reset-palette", change.Action, TangentSpaceSettingsController.PaletteField, Appearance.Word(Space.Palette.Base))
                    @ResetForm("appearance-reset-css", change.Action, TangentSpaceSettingsController.CssField, "")
                }
            </div>
        </section>
    </div>
</main>

@code {
    [Parameter, EditorRequired] public AppearanceSettingsPage Model { get; set; } = default!;

    /// <summary>Whether the reader may change the appearance here.</summary>
    private bool Mutable => Model.Gate is null;

    /// <summary>The place's image where it is one of its own rather than a bundled cover.</summary>
    private string? Own => Model.Image.StartsWith("/media/", StringComparison.Ordinal) ? Model.ImageAddress : null;

    /// <summary>The one press that returns a part to its default, shown while it is elsewhere, sending its own form.</summary>
    private RenderFragment Reset(string form, bool away, string label) => @<text>@if (Mutable && away)
        {
            <p class="post-form-note"><button type="submit" class="button" form="@form">@label</button></p>
        }</text>;

    /// <summary>A form of one field, which a part's reset sends, leaving every other choice as it is saved.</summary>
    private static RenderFragment ResetForm(string id, string action, string field, string value) =>
        @<form id="@id" class="change-appearance" method="post" action="@action" hidden><input type="hidden" name="@field" value="@value"></form>;

    /// <summary>One of the place's words: its Markdown as it stands, where it shows and how much it holds.</summary>
    private RenderFragment Words(string field, string label, string value, int rows, int limit, string note) => @<div class="field">
        <label class="field-label" for="@("space-appearance-" + field)">@label</label>
        <textarea class="post-form-body post-form-short" id="@("space-appearance-" + field)" name="@field" rows="@rows"
                  maxlength="@limit" readonly="@(!Mutable)" aria-describedby="@("space-appearance-" + field + "-note")">@value</textarea>
        <p class="post-form-note" id="@("space-appearance-" + field + "-note")">@note Markdown, at most @limit.ToString("N0", CultureInfo.InvariantCulture) characters.</p>
    </div>;

    private static string Name(string word) => char.ToUpperInvariant(word[0]) + word[1..];

    private static string BaseName(string word) => word switch
    {
        "tangent" => "Tangent's own",
        "simple" => "Simple.css",
        "mvp" => "MVP.css",
        "marx" => "Marx",
        "sakura" => "Sakura",
        "water" => "Water.css",
        "new" => "new.css",
        "concord" => "Concord",
        _ => Name(word)
    };

    private static string BaseDetail(string word) => word switch
    {
        "tangent" => "Newsreader and Schibsted Grotesk",
        "concord" => "A chat app's look, Tangent's own",
        _ => "Classless, in your system's fonts"
    };

    /// <summary>The swatch a palette's card shows: the accent it wears, gold for the base's own under Tangent's own base,
    /// and none for another base's own colours.</summary>
    private string? Swatch(string word) => word != "base" ? word : Model.Base == Appearance.Word(Space.Base.Tangent) ? "gold" : null;

    private string PaletteName(string word) => word == "base" ? "The base's own" : Name(word);

    private string PaletteDetail(string word) => word != "base" ? "Tangent's palette in " + word + ", over any base"
        : Model.Base == Appearance.Word(Space.Base.Tangent) ? "Tangent's palette in gold" : BaseName(Model.Base) + "'s own colours";

    /// <summary>The frame the shell draws around the page: the place and its settings as crumbs, and who reads, or where
    /// a visitor signs in.</summary>
    public static Frame Frame(AppearanceSettingsPage page)
        => new(page.Place, page.Door, [new Crumb(page.Place, page.Door), new Crumb("Settings")], page.Who, page.SignIn);
}
