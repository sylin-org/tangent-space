@using global::Tangent.Posts
@using global::Tangent.Render
@* Every Tangent the reader may view, in one panel: each its name, linked to it, its kind and how many Topics were
   started there, in the Tangents' order; where a new one is created, for whoever may; and the Tangents after and the
   first ones a link away. None reads as one sentence. *@
<main class="layout">
    <div class="layout-main">
        <section class="sign-in-panel post-form-panel panel" aria-labelledby="tangents-heading">
            <div class="sign-in-body">
                <p class="post-form-where">In <a href="@Model.Door">@Model.Place</a></p>
                <h1 id="tangents-heading" class="sign-in-title">Tangents</h1>
                @if (Model.Tangents.Count == 0)
                {
                    <p class="post-form-note">@(Model.Continued ? "No more Tangents." : "No Tangent is open to you here.")</p>
                }
                else
                {
                    <ul class="door-offers tangents-all list">
                        @foreach (var tangent in Model.Tangents)
                        {
                            <li class="door-offer row tangent" @key="tangent.Slug">
                                @if (tangent.Joining is { } joining)
                                {
                                    <p class="door-offer-line">
                                        @tangent.Name
                                        <span class="topic-row-none">· Members only · @Detail(tangent.Kind, tangent.TopicCount)</span>
                                    </p>
                                    @if (tangent.Description is { Length: > 0 } about)
                                    {
                                        <p class="post-form-note">@about</p>
                                    }
                                    <div class="door-offer-answers">
                                        @if (tangent.Join is { } join)
                                        {
                                            <form class="join-tangent" method="post" action="@join.Action">
                                                <button type="submit" class="button">@(joining == "join" ? "Join" : "Ask to join")</button>
                                            </form>
                                        }
                                        else if (joining == "asked")
                                        {
                                            <p class="post-form-note">You asked to join; whoever manages it will decide, and your door will tell you.</p>
                                        }
                                        else
                                        {
                                            <p class="post-form-note">Your ask to join was declined.</p>
                                        }
                                        @if (tangent.Withdraw is { } withdraw)
                                        {
                                            <form class="withdraw-ask" method="post" action="@withdraw.Action">
                                                <button type="submit" class="button">Withdraw</button>
                                            </form>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="door-offer-line">
                                        <a href="@tangent.Address">@tangent.Name</a>
                                        <span class="topic-row-none">· @Detail(tangent.Kind, tangent.TopicCount)</span>
                                    </p>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (Model.NewTangent is { } created)
                {
                    <a class="rail-new" href="@created">New Tangent</a>
                }
                @if (Model.Continued || Model.Next is not null)
                {
                    <nav class="topic-pages" aria-label="More Tangents">
                        @if (Model.Continued)
                        {
                            <a href="@Model.First">First Tangents</a>
                        }
                        @if (Model.Next is { } next)
                        {
                            <a class="topic-pages-next" href="@next">More Tangents →</a>
                        }
                    </nav>
                }
            </div>
        </section>
    </div>
</main>

@code {
    [Parameter, EditorRequired] public TangentsPage Model { get; set; } = default!;

    /// <summary>The frame the shell draws around the page: the place and its Tangents as crumbs, and who reads, or where a
    /// visitor signs in.</summary>
    public static Frame Frame(TangentsPage page)
        => new(page.Place, page.Door, [new Crumb(page.Place, page.Door), new Crumb("Tangents")], page.Who, page.SignIn);

    /// <summary>A Tangent's kind and how many Topics were started there, in words.</summary>
    public static string Detail(string kind, int topicCount) => kind == PostWrites.Word(PostKind.Article)
        ? "Articles · " + TopicRow.Count(topicCount, "article", "articles", "no articles yet")
        : "Discussions · " + TopicRow.Count(topicCount, "topic", "topics", "no topics yet");
}
