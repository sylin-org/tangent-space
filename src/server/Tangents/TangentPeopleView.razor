@using global::Tangent.Render
@* A Tangent's people: one panel that says how someone outside it comes in, with a choice for each way while it is
   private; the asks that wait, each let in or declined with one button; a search by the start of a handle, each found
   participant with what may be done for them; and who reads and posts here by role, linked to the access, and by
   person, paged both ways. Taking someone out, offered only where it keeps them out, opens in place to confirm. The
   moderators' Tangent says instead that its access stays. A refusal shows above it all. *@
<main class="sign-in post-form">
    <section class="sign-in-panel post-form-panel" aria-labelledby="people-heading">
        <div class="sign-in-body">
            <p class="post-form-where">Settings of <a href="@Model.Address">@Model.Name</a></p>
            <h1 id="people-heading" class="sign-in-title">People</h1>
            @if (Model.Failure is { } failure)
            {
                <p class="sign-in-failure" id="people-failure" role="alert">@failure</p>
            }
            @if (Model.Fixed)
            {
                <p class="post-form-note">Only moderators read this Tangent, and its access stays as it is.</p>
            }
            else
            {
                <p class="post-form-note">@AudienceLine()</p>
                @if (Model.ChangeJoining is { } joining)
                {
                    <form class="change-tangent-joining door-offer-answers people-answers" method="post" action="@joining.Action">
                        @foreach (var way in Model.Joinings)
                        {
                            <button type="submit" class="button" name="@TangentPeopleController.JoiningField" value="@way"
                                    aria-pressed="@(way == Model.Joining ? "true" : "false")" disabled="@(way == Model.Joining)">@JoiningButton(way)</button>
                        }
                    </form>
                }
            }

            @if (Model.Asking.Count > 0)
            {
                <h2 class="rail-heading rail-heading-spaced">Asking to join</h2>
                <ul class="door-offers applications people tangent-asks">
                    @foreach (var person in Model.Asking)
                    {
                        <li class="door-offer" @key="person.Id">
                            <p class="door-offer-line"><a href="@person.Profile">@person.Name</a> <span class="topic-row-none">· @@@person.Handle@Agent(person)</span></p>
                            @Actions(person)
                        </li>
                    }
                </ul>
            }

            @if (!Model.Fixed)
            {
                <form class="find-people" method="get" action="">
                    <label class="field-label" for="people-find">Find someone by handle</label>
                    <span class="field-row">
                        <input id="people-find" class="field-input" type="search" name="@TangentPeopleController.FindQuery" value="@Model.Find" placeholder="ada.example" autocomplete="off" spellcheck="false">
                        <button type="submit" class="button">Find</button>
                    </span>
                </form>
                @if (Model.Found is { } found)
                {
                    @if (found.Count == 0)
                    {
                        <p class="post-form-note">No one here has a handle that starts with @Model.Find.</p>
                    }
                    <ul class="door-offers applications people tangent-found">
                        @foreach (var person in found)
                        {
                            <li class="door-offer" @key="person.Id">
                                <p class="door-offer-line"><a href="@person.Profile">@person.Name</a> <span class="topic-row-none">· @@@person.Handle@Agent(person) · @StateLine(person.State)</span></p>
                                @Actions(person)
                            </li>
                        }
                    </ul>
                }
            }

            <h2 class="rail-heading rail-heading-spaced">Who reads and posts here</h2>
            <ul class="door-offers applications people tangent-people">
                <li class="door-offer"><p class="door-offer-line">Administrators <span class="topic-row-none">· read and post in every Tangent</span></p></li>
                @foreach (var role in Model.Roles)
                {
                    <li class="door-offer" @key="role.Word">
                        <p class="door-offer-line">@role.Name <span class="topic-row-none">· @(role.Access == "post" ? "read and post here" : "read here") · <a href="@Model.Access">change</a></span></p>
                    </li>
                }
                @foreach (var person in Model.People)
                {
                    <li class="door-offer" @key="person.Id">
                        <p class="door-offer-line"><a href="@person.Profile">@person.Name</a> <span class="topic-row-none">· @@@person.Handle@Agent(person) · @StateLine(person.State)</span></p>
                        @Actions(person)
                    </li>
                }
            </ul>
            @if (Model.People.Count == 0)
            {
                <p class="post-form-note">No one is in or kept out by name yet.</p>
            }
            @if (Model.First is not null || Model.Next is not null)
            {
                <nav class="topic-pages" aria-label="More people">
                    @if (Model.First is { } first)
                    {
                        <a href="@first">First people</a>
                    }
                    @if (Model.Next is { } next)
                    {
                        <a class="topic-pages-next" href="@next">More people →</a>
                    }
                </nav>
            }

            <div class="post-form-actions">
                <a class="post-form-cancel" href="@Model.Settings">Back to the settings</a>
            </div>
        </div>
    </section>
</main>

@code {
    [Parameter, EditorRequired] public TangentPeoplePage Model { get; set; } = default!;

    /// <summary>What may be done for one person, by the choices the page offers for them, each its own small form: an ask
    /// let in or declined with one button, anyone else let in with one, and someone in taken out once confirmed in place.</summary>
    private RenderFragment Actions(TangentPeoplePage.Person person) => @<div class="door-offer-answers people-answers">
        @if (Model.Change is { } change)
        {
            @foreach (var choice in person.Choices)
            {
                @if (choice == TangentPeopleController.OutChoice && person.State != "asked")
                {
                    <details class="application-decline people-take-out">
                        <summary class="button">Take out</summary>
                        <div class="post-remove-confirm">
                            <p class="post-remove-note">They stop reading it at once, and cannot join or ask again until you let them in.</p>
                            @Choice(change, person, choice, "Take out", "post-remove-submit")
                        </div>
                    </details>
                }
                else
                {
                    @Choice(change, person, choice, choice == TangentPeopleController.InChoice ? "Let in" : "Decline", "button")
                }
            }
        }
    </div>;

    private static RenderFragment Choice(Form change, TangentPeoplePage.Person person, string choice, string label, string style) =>
        @<form class="let-into-tangent" method="post" action="@change.Action">
            <input type="hidden" name="@TangentPeopleController.PersonField" value="@person.Id">
            <button type="submit" class="@style" name="@TangentPeopleController.ChoiceField" value="@choice">@label</button>
        </form>;

    private static string Agent(TangentPeoplePage.Person person) => person.Kind == "agent" ? " · agent" : "";

    private string AudienceLine() => Model.Audience == "public"
        ? "It is public: everyone who reads the place reads it. Make it private in its settings to keep it to its members."
        : Model.Joining switch
        {
            "join" => "It is members-only: anyone who takes part in the place may join it.",
            "ask" => "It is members-only: people ask to join, and you decide.",
            _ => "It is private: only the roles and people below read it, and no one else finds it."
        };

    private static string JoiningButton(string way) => way switch
    {
        "join" => "Anyone joins",
        "ask" => "People ask to join",
        _ => "Only who you let in"
    };

    /// <summary>Where one person stands here, in words. A public Tangent is read by everyone who reads the place, so someone
    /// kept out of it is kept out again only once it is private.</summary>
    private string StateLine(string state) => state switch
    {
        "in" => "reads and posts here",
        TangentPeopleController.RoleState => "reads here through a role",
        TangentPeopleController.KeptOutState => Model.Audience == "public" ? "kept out while it is private" : "kept out",
        "asked" => "asked to join",
        "declined" => "ask declined",
        _ => "not in"
    };

    /// <summary>The frame the shell draws around the page: the place; the Tangent, its settings and its people as crumbs;
    /// and who reads.</summary>
    public static Frame Frame(TangentPeoplePage page)
        => new(page.Place, page.Door, [new Crumb(page.Name, page.Address), new Crumb("Settings", page.Settings), new Crumb("People")], page.Who);
}
