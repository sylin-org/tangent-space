@using global::Tangent.Posts
@using global::Tangent.Render
@* A Tangent's access: one panel in the page that says who reads it by its audience, linked to the settings that change
   it, then the roles in their order, one line each with what the role holds here, and, for a reader who may change it,
   a button for each other access, each its own small form. The moderators' Tangent says instead that its access stays.
   A reader who may not change it reads why and nothing else, and a visitor the way to sign in; a refusal shows above
   the list. *@
<main class="sign-in post-form">
    <section class="sign-in-panel post-form-panel" aria-labelledby="access-heading">
        <div class="sign-in-body">
            <p class="post-form-where">Settings of <a href="@Model.Address">@Model.Name</a></p>
            <h1 id="access-heading" class="sign-in-title">Access</h1>
            @if (Model.Gate is { } gate)
            {
                <p class="sign-in-failure" id="access-failure" role="alert" data-gate="@gate">
                    @if (Model.SignIn is { } signIn)
                    {
                        @(PostWrites.Sentence(gate) + " ")<a href="@signIn">Sign in</a>
                    }
                    else
                    {
                        @PostWrites.Sentence(gate)
                    }
                </p>
            }
            else
            {
                @if (Model.Failure is { } failure)
                {
                    <p class="sign-in-failure" id="access-failure" role="alert">@failure</p>
                }
                <p class="post-form-note">
                    @Audience()
                    @if (!Model.Fixed)
                    {
                        @(" ")<a href="@Model.Settings">Its settings</a>@(" change who reads it.")
                    }
                </p>
                <ul class="door-offers applications people tangent-access">
                    @foreach (var role in Model.Roles)
                    {
                        <li class="door-offer" @key="role.Word">
                            <p class="door-offer-line">
                                @role.Name <span class="topic-row-none">· @Holds(role.Access)</span>
                            </p>
                            @if (Model.Change is { } change && role.Offered.Count > 0)
                            {
                                <div class="door-offer-answers people-answers">
                                    @foreach (var access in role.Offered)
                                    {
                                        <form method="post" action="@change.Action">
                                            <FormTokenField Token="@change.Token" />
                                            <input type="hidden" name="@TangentAccessController.RoleField" value="@role.Word">
                                            <button type="submit" class="watch-button" name="@TangentAccessController.AccessField" value="@access">@Button(access)</button>
                                        </form>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
                <p class="post-form-note">Administrators read and post in every Tangent.</p>
                @if (Model.Previous is not null || Model.Next is not null)
                {
                    <nav class="topic-pages" aria-label="More roles">
                        @if (Model.Previous is { } previous)
                        {
                            <a href="@previous">Higher roles</a>
                        }
                        @if (Model.Next is { } next)
                        {
                            <a class="topic-pages-next" href="@next">Lower roles</a>
                        }
                    </nav>
                }
                <div class="post-form-actions">
                    <a class="post-form-cancel" href="@Model.Settings">Back to the settings</a>
                </div>
            }
        </div>
    </section>
</main>

@code {
    [Parameter, EditorRequired] public TangentAccessPage Model { get; set; } = default!;

    /// <summary>Who reads the Tangent, in a sentence.</summary>
    private string Audience() => Model.Fixed
        ? "Only moderators read this Tangent, and its access stays as it is."
        : Model.Audience == "private"
            ? "It is private: administrators read it, and so do the roles given read or post below."
            : "It is public: everyone who reads the place reads it, and each role posts as it does in the place unless it is given read alone.";

    /// <summary>What a role holds here, in words.</summary>
    private static string Holds(string access) => access switch
    {
        "read" => "reads here, and posts nothing",
        "post" => "reads and posts here",
        _ => "as its role allows in the place"
    };

    /// <summary>The button that sets a role's access, in words.</summary>
    private static string Button(string access) => access switch
    {
        "read" => "Reads only",
        "post" => "Reads and posts",
        _ => "As in the place"
    };

    /// <summary>The frame the shell draws around the page: the place; the Tangent, its settings and its access as crumbs;
    /// and who reads, or where a visitor signs in.</summary>
    public static Frame Frame(TangentAccessPage page)
        => new(page.Place, page.Door, [new Crumb(page.Name, page.Address), new Crumb("Settings", page.Settings), new Crumb("Access")], page.Who, page.SignIn);
}
