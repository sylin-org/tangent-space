@using global::Tangent.Render
@* The watch toggle of a Tangent or a Topic, for a signed-in reader: whether they watch it, and the button that posts
   the opposite flag. A visitor has none. *@
@if (Model is { } watching)
{
    <form class="@("watch-form " + Tool)" method="post" action="@watching.Form.Action">
        <input type="hidden" name="@CheckpointController.WatchField" value="@watching.Form.Value(CheckpointController.WatchField)">
        @if (watching.Watch)
        {
            <span class="badge is-watched">Watching</span>
        }
        <button type="submit" class="watch-button">@(watching.Watch ? "Stop watching" : "Watch")</button>
    </form>
}

@code {
    [Parameter] public Watching? Model { get; set; }

    /// <summary>The name of the tool the form sends: <c>watch-tangent</c> or <c>watch-topic</c>.</summary>
    [Parameter, EditorRequired] public string Tool { get; set; } = "";
}
