@using global::Tangent.Render
@* The seen control at the end of a Topic's window, while the window continues from the reader's mark and reaches past
   it: a button that moves the mark through the window's last sequence. The seen island posts it by itself once the end
   of the window has been on screen. *@
@if (Model is { } seen)
{
    <form class="topic-seen seen" method="post" action="@seen.Action" data-island="seen">
        @foreach (var field in seen.Fields)
        {
            <input type="hidden" name="@field.Name" value="@field.Value">
        }
        <button type="submit" class="button">Mark seen</button>
    </form>
}

@code {
    [Parameter] public Form? Model { get; set; }
}
