<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
    <ProjectReference Include="$(KoanSourceRoot)/src/Koan.Web/Koan.Web.csproj" />
    <ProjectReference Include="$(KoanSourceRoot)/src/Connectors/Data/Sqlite/Koan.Data.Connector.Sqlite.csproj" />
    <ProjectReference Include="$(KoanSourceRoot)/src/Koan.Identity/Koan.Identity.csproj" />
    <ProjectReference Include="$(KoanSourceRoot)/src/Koan.Identity.Web/Koan.Identity.Web.csproj" />
    <ProjectReference Include="$(KoanSourceRoot)/src/Connectors/Web/Auth/Atproto/Koan.Web.Auth.Connector.Atproto.csproj" />
    <ProjectReference Include="$(KoanSourceRoot)/src/Connectors/AI/Onnx/Koan.AI.Connector.Onnx.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TangentSpace.Tests" />
  </ItemGroup>
  <!-- Side-loaded embedding artifacts (air-gap friendly; resolved against the build output). -->
  <ItemGroup>
    <Content Include="models\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
