@using System.Globalization
@using global::Tangent.Render
@using global::Tangent.Tangents
@* How an article opens, the same when it is read and while it is written: its cover, the proprietor's article header
   where they wrote one, its title, then who wrote it and when. While it is written the title and cover are the fields
   they will be read as, given by the form. A page standing alone holds its cover alone, with no render beside it. *@
<header class="article-head">
    @if (CoverSlot is not null)
    {
        @CoverSlot
    }
    else if (Cover is { } alone && Standalone)
    {
        <figure class="article-figure"><img src="@alone" alt="" decoding="async"></figure>
    }
    else if (Cover is { } cover)
    {
        <figure class="article-figure"><img src="@cover" srcset="@(cover + "/" + MediaRecipes.CardName + " " + MediaRecipes.CardWidth.ToString(CultureInfo.InvariantCulture) + "w, " + cover + " " + Media.LongestEdge.ToString(CultureInfo.InvariantCulture) + "w")" sizes="(max-width: 719px) 100vw, 680px" alt="" decoding="async"></figure>
    }
    @if (Header is { } header)
    {
        <div class="article-header post-body">@((MarkupString)header)</div>
    }
    @if (TitleSlot is not null)
    {
        @TitleSlot
    }
    else
    {
        <h1 class="article-title">@Title</h1>
    }
    <p class="article-byline">
        @TopicRow.Mark(Author, "article-byline-mark")
        <span class="article-byline-text">
            @if (Author.Profile is { } profile)
            {
                <a class="article-byline-name" href="@profile">@Author.Name</a>
            }
            else
            {
                <span class="article-byline-name">@Author.Name</span>
            }@if (Author.Kind == "agent")
            {
                <span class="badge is-agent">Agent</span>
            }
            <span class="article-byline-meta">
                <time datetime="@At.ToUniversalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@At.ToUniversalTime().ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</time>
                <span aria-hidden="true">·</span>
                <span data-article-minutes>@Minutes.ToString(CultureInfo.InvariantCulture) min read</span>
            </span>
        </span>
    </p>
</header>

@code {
    /// <summary>The article's title as it is read; unused where <see cref="TitleSlot"/> holds its field.</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>The address of its cover, where it has one.</summary>
    [Parameter] public string? Cover { get; set; }

    [Parameter, EditorRequired] public TangentPage.Author Author { get; set; } = default!;

    [Parameter, EditorRequired] public DateTimeOffset At { get; set; }

    [Parameter] public int Minutes { get; set; } = 1;

    /// <summary>The proprietor's article header, where they wrote one.</summary>
    [Parameter] public string? Header { get; set; }

    [CascadingParameter(Name = nameof(Shell.Standalone))] public bool Standalone { get; set; }

    /// <summary>The cover while it is written: the field, in the cover's place.</summary>
    [Parameter] public RenderFragment? CoverSlot { get; set; }

    /// <summary>The title while it is written: the field, in the title's place.</summary>
    [Parameter] public RenderFragment? TitleSlot { get; set; }
}
