@using global::Tangent.Render
@using global::Tangent.Tangents
@* The form that starts a Topic: one panel in the page, saying which Tangent it posts in, with a title and a body. The
   Post's Id rides in a hidden field, minted when the page was rendered, so a form sent twice starts one Topic. A reader
   who may not start a Topic here reads why above the form, whose fields are read-only and which has no button, and a
   visitor the way to sign in; a refusal of a field shows under that field, which takes the focus, and any other above
   the form. For a participant who may post, the composer island keeps the words as a draft and sends them. Taking a
   Post on a tangent, the panel quotes the Post, lists the Tangents the reader may start the Topic in as links to this
   form there, the one it is in marked, offers a title from the Post's first words, and leaves the reader's own words
   optional. *@
@if (Article && Model.Start is { } writing && Model.Who is { } author)
{
    <ArticleForm Tool="start-topic" Heading="@Heading" TangentName="@Model.TangentName" TangentAddress="@Model.TangentAddress" Action="@writing.Action"
                 Author="@(new TangentPage.Author(author.Id, author.Handle, author.Name, "person", author.Avatar))" At="@(new DateTimeOffset(Model.Day, TimeOnly.MinValue, TimeSpan.Zero))"
                 Door="@Model.Door" TitleId="new-topic-title" BodyId="new-topic-body" Island="composer" IslandProps="@ComposerProps()" Bring="@Model.Bring" Participant="@author.Id"
                 Title="@Model.Title" Body="@Model.Body" CoverId="@Model.CoverId" Failure="@Model.Failure" TitleFailure="@Model.TitleFailure" BodyFailure="@Model.BodyFailure">
        <Above>@Taking</Above>
        <Hidden><input type="hidden" name="@PostWrites.IdField" value="@writing.Value(PostWrites.IdField)">@OriginField</Hidden>
        <Actions>
            <span class="post-form-as">Writing in <a href="@Model.TangentAddress">@Model.TangentName</a></span>
            <button type="submit" class="sign-in-submit post-form-submit" data-busy-label="Publishing…">Publish</button>
        </Actions>
    </ArticleForm>
}
else
{
<main class="sign-in post-form">
    <section class="sign-in-panel post-form-panel" aria-labelledby="new-topic-heading">
        <div class="sign-in-body">
            @if (Model.Origin is { } origin)
            {
                <p class="post-form-where">From <a href="@origin.TopicAddress">@origin.Topic</a> in <a href="@origin.TangentAddress">@origin.Tangent</a></p>
            }
            else
            {
                <p class="post-form-where">Posting in <a href="@Model.TangentAddress">@Model.TangentName</a></p>
            }
            <h1 id="new-topic-heading" class="sign-in-title">@Heading</h1>
            @Taking
            @if (Model.Gate is { } gate)
            {
                <p class="sign-in-failure" id="new-topic-failure" role="alert" data-gate="@gate">
                    @if (Model.SignIn is { } signIn)
                    {
                        @(Access.Capabilities.Sentence(gate) + " ")<a href="@signIn">Sign in</a>
                    }
                    else
                    {
                        @Access.Capabilities.Sentence(gate)
                    }
                </p>
            }
            else if (Model.Failure is { } failure)
            {
                <p class="sign-in-failure" id="new-topic-failure" role="alert">@failure</p>
            }
            <form class="sign-in-form start-topic" method="post" action="@Model.Start?.Action" data-island="@(Composing ? "composer" : null)" data-props="@ComposerProps()">
                @if (Model.Start is { } start)
                {
                    <input type="hidden" name="@PostWrites.IdField" value="@start.Value(PostWrites.IdField)">
                    @OriginField
                }
                <div class="field">
                    <label class="field-label" for="new-topic-title">Title</label>
                    <span class="field-input">
                        <input id="new-topic-title" name="@PostWrites.TitleField" type="text" required maxlength="@Post.TitleLimit" autocomplete="off"
                               autofocus="@(Model.Gate is null && Focus == "new-topic-title")" readonly="@(Model.Gate is not null)" value="@Model.Title"
                               aria-invalid="@(Model.TitleFailure is null ? "false" : "true")"
                               aria-describedby="@(Model.TitleFailure is null ? null : "new-topic-title-failure")">
                    </span>
                    @if (Model.TitleFailure is { } titleFailure)
                    {
                        <p class="field-failure" id="new-topic-title-failure">@titleFailure</p>
                    }
                </div>
                <div class="field">
                    <label class="field-label" for="new-topic-body">@(Model.Origin is not null ? "Your words (optional)" : Article ? "Article" : "Post")</label>
                    <textarea class="post-form-body" id="new-topic-body" name="@PostWrites.BodyField" rows="@(Model.Origin is null ? 12 : 6)" required="@(Model.Origin is null)"
                              autofocus="@(Model.Gate is null && Focus == "new-topic-body")" readonly="@(Model.Gate is not null)"
                              data-island="@(Model.Gate is null ? "suggest" : null)" data-props="@SuggestionsController.Props(Model.TangentAddress)"
                              aria-invalid="@(Model.BodyFailure is null ? "false" : "true")"
                              aria-describedby="@(Model.BodyFailure is null ? null : "new-topic-body-failure")">@Model.Body</textarea>
                    @if (Model.BodyFailure is { } bodyFailure)
                    {
                        <p class="field-failure" id="new-topic-body-failure">@bodyFailure</p>
                    }
                </div>
                @if (Model.Gate is null)
                {
                    <div class="post-form-actions">
                        @if (Model.Who is { } who)
                        {
                            <span class="post-form-as">Posting as <strong>@("@" + who.Handle)</strong></span>
                        }
                        <button type="submit" class="sign-in-submit post-form-submit" data-busy-label="@(Model.Origin is null ? "Posting…" : "Starting…")">@(Model.Origin is null ? "Post" : "Start the topic")</button>
                    </div>
                }
            </form>
        </div>
    </section>
</main>
}

@code {
    [Parameter, EditorRequired] public NewTopicPage Model { get; set; } = default!;

    private bool Article => Model.Kind == PostWrites.Word(PostKind.Article);

    /// <summary>The page's heading: taking a Post on a tangent, else a new article or topic.</summary>
    private string Heading => Model.Origin is not null ? "Take this on a tangent" : Article ? "New article" : "New topic";

    /// <summary>The Post taken on a tangent, in the form's hidden field.</summary>
    private RenderFragment? OriginField => Model.Origin is { } origin
        ? @<input type="hidden" name="@PostWrites.OriginField" value="@origin.Id">
        : null;

    /// <summary>Taking a Post on a tangent: the Post quoted, then the Tangents to start the Topic in, each a link to this
    /// form there, this one marked, and the rest a page away.</summary>
    private RenderFragment? Taking => Model.Origin is not { } origin ? null : @<div class="post-form-taking">
        <PostQuote Model="@origin" />
        @if (Model.Choices is { Count: > 0 } choices)
        {
            <nav class="post-form-choice" aria-labelledby="new-topic-choices">
                <p class="field-label" id="new-topic-choices">Start it in</p>
                <div class="post-form-options">
                    @foreach (var choice in choices)
                    {
                        <a class="post-form-option" href="@choice.Address" data-tangent="@choice.Slug" aria-current="@(choice.Current ? "page" : null)">
                            <span class="post-form-option-text">
                                <span class="post-form-option-name">@choice.Name</span>
                                <span class="post-form-option-detail">@(choice.Kind == PostWrites.Word(PostKind.Article) ? "Starts an article" : "Starts a topic")</span>
                            </span>
                        </a>
                    }
                </div>
                @if (Model.First is not null || Model.More is not null)
                {
                    <p class="topic-pages">
                        @if (Model.First is { } first)
                        {
                            <a href="@first">First Tangents</a>
                        }
                        @if (Model.More is { } more)
                        {
                            <a class="topic-pages-next" href="@more">More Tangents →</a>
                        }
                    </p>
                }
            </nav>
        }
    </div>;

    /// <summary>Whether the composer island takes the form: for a participant who may start a Topic here.</summary>
    private bool Composing => Model.Start is not null && Model.Who is not null;

    /// <summary>The composer's props: whose drafts these are, the Tangent they are kept under, and the prefix of the
    /// address that names a new Topic by its root's TID until its slug is known.</summary>
    private string? ComposerProps() => Composing
        ? System.Text.Json.JsonSerializer.Serialize(new
        {
            participant = Model.Who!.Id,
            scope = Model.Origin is { } origin ? "origin:" + origin.Id : "tangent:" + Model.Tangent,
            locate = Model.TangentAddress + "/",
            noun = Article ? "article" : "topic"
        })
        : null;

    /// <summary>The field the page opens on: the first one a refusal concerns, else the title.</summary>
    private string Focus => Model.TitleFailure is null && Model.BodyFailure is not null ? "new-topic-body" : "new-topic-title";

    /// <summary>The frame the shell draws around the page: the place; the Tangent and the form as crumbs; and who reads,
    /// or where a visitor signs in.</summary>
    public static Frame Frame(NewTopicPage page)
        => new(page.Place, page.Door,
            page.Origin is { } origin
                ? [new Crumb(origin.Tangent, origin.TangentAddress), new Crumb(origin.Topic, origin.TopicAddress), new Crumb("Take this on a tangent")]
                : [new Crumb(page.TangentName, page.TangentAddress), new Crumb(page.Kind == PostWrites.Word(PostKind.Article) ? "New article" : "New topic")],
            page.Who, page.SignIn);
}
