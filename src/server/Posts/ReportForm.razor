@using global::Tangent.Render
@* Report on one Post of a Topic: for a signed-in reader, on a Post that is not removed, a disclosure that opens a short
   form in the page — a sentence for the moderators, which they may leave out, and the button that sends it — posting to
   the Post's report address with the TID minted for it, so a form sent twice is one report. *@
@if (Model.Report is { } report)
{
    <details class="post-report">
        <summary class="post-action">Report</summary>
        <form class="post-report-form report" method="post" action="@report.Action">
            <input type="hidden" name="@PostWrites.IdField" value="@report.Value(PostWrites.IdField)">
            <label class="field-label" for="@("report-" + Model.Id)">Anything the moderators should know? (optional)</label>
            <textarea class="post-form-body post-report-body" id="@("report-" + Model.Id)" name="@PostWrites.BodyField" rows="2"
                      aria-describedby="@("report-note-" + Model.Id)"></textarea>
            <p class="post-report-note" id="@("report-note-" + Model.Id)">Only the moderators read it, and its author is never told. It removes nothing by itself.</p>
            <button type="submit" class="sign-in-submit post-report-submit">Send the report</button>
        </form>
    </details>
}

@code {
    [Parameter, EditorRequired] public TopicPage.Post Model { get; set; } = default!;
}
