@using System.Globalization
@using global::Tangent.Render
@* The Topic page: the rail with the way back to the Tangent and the replies this window holds; then the title,
   when it started and how many replies it has, the root, and one window of replies in order, with
   the way to the older window above them and to the newer below, and where the reader replies or why they may not. A
   Topic without replies says so in one sentence. Zeros are said in words. An article opens with its own head, which holds
   the proprietor's article header, where they wrote one; its outline stands in the rail, and folded above its body where
   the rail folds; and a reader who may reply can quote a passage of it into the reply box. *@
<main class="layout layout-reading topic-layout">
    <aside class="rail" aria-label="In this Tangent">
        <h2 class="rail-heading">@Model.Tangent.Name</h2>
        <ul class="rail-views list">
            <li><a href="@Model.Tangent.Address">@(Article ? "All articles" : "All topics")</a></li>
            @if (Model.NewTopic is { } start)
            {
                <li><a href="@start">@(Article ? "New article" : "New topic")</a></li>
            }
        </ul>
        @if (Model.Replies.Count > 0)
        {
            <h2 class="rail-heading rail-heading-spaced">In this window</h2>
            <ul class="topic-rail-replies list">
                @foreach (var reply in Model.Replies)
                {
                    <li>
                        <a class="@("row post" + (reply.Id == Model.Anchor ? " is-current" : "") + (reply.New ? " is-new" : ""))" href="@("#" + reply.Id)" aria-current="@(reply.Id == Model.Anchor ? "true" : null)">
                            @TopicRow.Mark(reply.Author, "author-mark", Model.Who?.Id)
                            <span class="topic-rail-reply-text">
                                <span class="topic-rail-reply-name">@reply.Author.Name</span>
                                <span class="topic-rail-reply-time">@TopicRow.When(reply.CreatedAt, Model.Day)</span>
                            </span>
                            @if (reply.New)
                            {
                                <span class="badge is-new">New</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        }
        @if (Contents.Count > 1)
        {
            <nav class="article-outline" aria-labelledby="article-outline-heading">
                <h2 id="article-outline-heading" class="rail-heading rail-heading-spaced">In this article</h2>
                <ul class="rail-views list">
                    @foreach (var entry in Contents)
                    {
                        <li class="@(entry.Level > 2 ? "article-outline-sub" : null)"><a href="@("#" + entry.Id)">@entry.Text</a></li>
                    }
                </ul>
            </nav>
        }
    </aside>
    <div class="layout-main topic-main topic">
        @if (Article)
        {
            <article class="article">
                <ArticleHead Title="@Model.Title" Cover="@Model.Cover" Author="@Model.Root.Author" WrittenAs="@Model.Root.WrittenAs" At="@Model.Root.CreatedAt" Minutes="@Model.ReadMinutes" Header="@Model.ArticleHeader" />
                <TakenFrom Model="@Model.TakenFrom" />
                @if (Contents.Count > 1)
                {
                    <details class="article-outline-folded">
                        <summary>In this article</summary>
                        <ul class="list">
                            @foreach (var entry in Contents)
                            {
                                <li class="@(entry.Level > 2 ? "article-outline-sub" : null)"><a href="@("#" + entry.Id)">@entry.Text</a></li>
                            }
                        </ul>
                    </details>
                }
                <TopicPost Model="@Model.Root" Today="@Model.Day" Root="true" Article="true" Door="@Model.Door" Anchor="@(Model.Anchor == Model.Root.Id)" Reader="@Model.Who?.Id" Quote="@QuoteProps" />
                <Tangent.Connections.PublishLine Model="@Model.Publishing" />
                <Tangent.Connections.ElsewhereLine Model="@Model.Elsewhere" />
            </article>
        }
        else
        {
            <h1 class="topic-title">@Model.Title</h1>
            <p class="topic-meta">
                <span>Started <time datetime="@Model.Root.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@TopicRow.When(Model.Root.CreatedAt, Model.Day)</time></span>
                <span aria-hidden="true">·</span>
                <span>@TopicRow.Count(Model.ReplyCount, "reply", "replies", "No replies yet")</span>
            </p>
            <TakenFrom Model="@Model.TakenFrom" />
            <TopicPost Model="@Model.Root" Today="@Model.Day" Root="true" Door="@Model.Door" Anchor="@(Model.Anchor == Model.Root.Id)" Reader="@Model.Who?.Id" />
        }
        <section class="topic-replies" aria-labelledby="topic-replies-title">
            <div class="topic-replies-head">
                <h2 id="topic-replies-title" class="topic-replies-title">Replies</h2>
                @if (Model.From is { } from && Model.Through is { } through)
                {
                    <span class="topic-replies-range">@Range(from, through)</span>
                }
            </div>
            @if (Model.Older is { } older)
            {
                <nav class="topic-pages" aria-label="Older replies">
                    <a href="@older">← Older replies</a>
                </nav>
            }
            @if (Model.Replies.Count == 0)
            {
                <p class="topic-replies-empty">@(Model.ReplyCount == 0 ? "No replies yet." : "Nothing further this way.")</p>
            }
            @foreach (var reply in Model.Replies)
            {
                <TopicPost Model="@reply" Today="@Model.Day" Door="@Model.Door" Anchor="@(Model.Anchor == reply.Id)" ParentAuthor="@ParentAuthor(reply)" Reader="@Model.Who?.Id" />
            }
            @if (Model.Who is { } reader && !Standalone)
            {
                <span hidden data-island="reading" data-props="@ReadingProps(reader)"></span>
            }
            <Tangent.Events.TopicSeenForm Model="@Model.Seen" />
            <Tangent.Events.Live Page="topic" Tangent="@Model.Tangent.Slug" Topic="@Model.Id" Address="@Model.Address" Newest="@(Model.Newer is null)" />
            @if (Model.Newer is { } newer)
            {
                <nav class="topic-pages" aria-label="Newer replies">
                    <a class="topic-pages-next" href="@newer">Newer replies →</a>
                </nav>
            }
        </section>
        <ReplyForm Model="@Model" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public TopicPage Model { get; set; } = default!;

    /// <summary>The frame the shell draws around the page: the place; the Tangent and the Topic as crumbs; and who
    /// reads, or where a visitor signs in.</summary>
    public static Frame Frame(TopicPage page)
    {
        var who = page.Who is { } reader ? new Who(reader.Id, reader.Name, reader.Handle, reader.Role, reader.Avatar, reader.SignOut, reader.Settings, reader.ForYou) : null;
        return new(page.Place, page.Door, [new Crumb(page.Tangent.Name, page.Tangent.Address), new Crumb(page.Title)], who, page.SignIn, page.Feeds,
            Document: page.Document);
    }

    private bool Article => Model.Kind == "article";

    [CascadingParameter(Name = nameof(Shell.Standalone))] public bool Standalone { get; set; }

    /// <summary>An article's outline, from its root's body as the page renders it; none for a discussion or a removed root.</summary>
    private IReadOnlyList<Outline.Entry> Contents => _contents ??= Article && Model.Root.Body is { } body
        ? Outline.Of(Mentions.Html(Model.Root.Id, Model.Root.Version, body, Model.Root.Mentions)).Entries
        : [];

    private IReadOnlyList<Outline.Entry>? _contents;

    /// <summary>The reading island's props: whose place it keeps, the Topic, and whether this window is its newest, at
    /// whose end the Topic has been read through.</summary>
    private string ReadingProps(TopicPage.Reader reader) => System.Text.Json.JsonSerializer.Serialize(new
    {
        participant = reader.Id,
        topic = Model.Id,
        title = Model.Title,
        address = Model.Address,
        newest = Model.Newer is null
    });

    /// <summary>The quote island's props, where the reader may reply: the article's address, which a quoted passage's
    /// link opens at its heading.</summary>
    private string? QuoteProps => Model.Reply is null ? null : System.Text.Json.JsonSerializer.Serialize(new { address = Model.Address });

    /// <summary>The replies the window holds, by their place in the Topic.</summary>
    private static string Range(long from, long through) => from == through
        ? "#" + from.ToString(CultureInfo.InvariantCulture)
        : "#" + from.ToString(CultureInfo.InvariantCulture) + "–" + through.ToString(CultureInfo.InvariantCulture);

    /// <summary>The name of the author of the Post a reply answers, where this window holds that Post.</summary>
    private string? ParentAuthor(TopicPage.Post reply)
        => reply.ParentId is { } parent ? Model.Replies.FirstOrDefault(post => post.Id == parent)?.Author.Name : null;
}
