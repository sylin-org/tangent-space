{
  "$meta": {
    "name": "Tangent Space",
    "release": "Round 3",
    "date": "2026-09-29",
    "cssPrefix": "--ts-",
    "themes": [
      "system (default: follows the device)",
      "light (Paper)",
      "dark (Ink)"
    ],
    "howToApply": "Set data-theme=\"light|dark\" on <html>, or leave it off for System. Set data-accent to pick the Space accent."
  },
  "font": {
    "display": "'Newsreader', Georgia, serif",
    "ui": "'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace"
  },
  "fontSource": "Google Fonts: Newsreader (opsz 6-72, 300-700, italic), Schibsted Grotesk (400-700, italic), IBM Plex Mono (400, 500)",
