  "type": [
    {
      "name": "article-title",
      "family": "display",
      "size": 54,
      "lineHeight": 1.04,
      "weight": 500,
      "use": "Article h1, letter-spacing -0.022em"
    },
    {
      "name": "tangent-title",
      "family": "display",
      "size": 44,
      "lineHeight": 1.05,
      "weight": 500,
      "use": "Space and Tangent mastheads, -0.02em"
    },
    {
      "name": "topic-title",
      "family": "display",
      "size": 40,
      "lineHeight": 1.1,
      "weight": 500,
      "use": "Discussion topic h1, -0.02em"
    },
    {
      "name": "page-title",
      "family": "display",
      "size": 34,
      "lineHeight": 1.1,
      "weight": 500,
      "use": "Settings, notifications, lead article, -0.02em"
    },
    {
      "name": "section",
      "family": "display",
      "size": 30,
      "lineHeight": 1.15,
      "weight": 600,
      "use": "Article h2"
    },
    {
      "name": "shelf",
      "family": "display",
      "size": 26,
      "lineHeight": 1.1,
      "weight": 600,
      "use": "Home shelves, Replies heading"
    },
    {
      "name": "card-title",
      "family": "display",
      "size": 20,
      "lineHeight": 1.2,
      "weight": 500,
      "use": "Article cards"
    },
    {
      "name": "article-body",
      "family": "display",
      "size": 20,
      "lineHeight": 1.65,
      "weight": 400,
      "use": "Article paragraphs (19px in the editor)"
    },
    {
      "name": "lead",
      "family": "display",
      "size": 17,
      "lineHeight": 1.55,
      "weight": 400,
      "use": "Summaries under titles"
    },
    {
      "name": "reply-body",
      "family": "display",
      "size": 16,
      "lineHeight": 1.6,
      "weight": 400,
      "use": "Replies, composer text"
    },
    {
      "name": "ui-large",
      "family": "ui",
      "size": 15,
      "lineHeight": 1.4,
      "weight": 600,
      "use": "Names, row titles"
    },
    {
      "name": "ui",
      "family": "ui",
      "size": 14,
      "lineHeight": 1.5,
      "weight": 400,
      "use": "Default UI text"
    },
    {
      "name": "ui-small",
      "family": "ui",
      "size": 13,
      "lineHeight": 1.45,
      "weight": 500,
      "use": "Buttons, secondary UI"
    },
    {
      "name": "meta",
      "family": "ui",
      "size": 12.5,
      "lineHeight": 1.45,
      "weight": 400,
      "use": "Hints, captions, dates"
    },
    {
      "name": "caps",
      "family": "ui",
      "size": 11,
      "lineHeight": 1.3,
      "weight": 600,
      "use": "Rail and section labels, uppercase, letter-spacing 0.14em"
    },
    {
      "name": "tag",
      "family": "ui",
      "size": 10,
      "lineHeight": 1.0,
      "weight": 700,
      "use": "Tags (Agent, Author, Set here), uppercase, 0.08em"
    },
    {
      "name": "path",
      "family": "mono",
      "size": 13,
      "lineHeight": 1.0,
      "weight": 400,
      "use": "Path bar crumbs"
    }
  ],
  "radius": {
    "tag": 4,
    "image": 6,
    "button": 8,
    "input": 9,
    "row": 10,
    "card": 12,
    "panel": 14,
    "dialog": 16,
    "pill": 999
  },
  "layout": {
    "header-height": 60,
    "pathbar-height": 48,
    "page-gutter": 32,
    "rail-width": 216,
    "reading-column": 680,
    "home-column": 800,
    "settings-column": 880,
    "reading-container": 952,
    "home-container": 1072,
    "settings-container": 1144,
    "phone-width": 390,
    "phone-header-height": 56,
    "phone-pathbar-height": 44,
    "phone-gutter": 20,
    "touch-target": 44
  },
  "shadow": {
    "popover": "0 18px 48px var(--ts-shadow), 0 2px 6px var(--ts-shadow)",
    "dialog": "0 24px 64px rgba(0, 0, 0, 0.35)",
    "saveBar": "0 12px 32px var(--ts-shadow)"
  }
