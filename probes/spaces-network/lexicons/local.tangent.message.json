{
  "lexicon": 1,
  "id": "local.tangent.message",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "createdAt": { "type": "string", "format": "datetime" },
          "replyTo": { "type": "ref", "ref": "#source" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["uri", "cid"],
      "properties": {
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "cid": { "type": "string", "format": "cid", "maxLength": 128 }
      }
    }
  }
}
